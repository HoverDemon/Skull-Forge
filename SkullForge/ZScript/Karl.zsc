Class SF_Player : DoomPlayer
{
    Default
    {
        Speed 1.05;
        Radius 16;
        Height 56;
        Player.JumpZ 9.0;

        Player.TeleportFreezeTime 6;
        Player.DisplayName "Karl";
        Player.StartItem "SF_Axe";

        Player.WeaponSlot 1, "SF_Axe", "SF_RipSaw";
        Player.WeaponSlot 2, "SF_NOVA";
        Player.WeaponSlot 3, "SF_Slugger", "SF_Dominatus";
        Player.WeaponSlot 4, "SF_Viper";
        Player.WeaponSlot 5, "SF_SpeedHucker";

        DamageFactor "NODAMAGEPLAYER", 0;

        // Disable engine’s own bobbing – we do custom view bob
        Player.ViewBob 0;
    }

    // ---------- ORIGINAL SF_PLAYER VARIABLES ----------
    bool isUsing;
    bool isWallAttached;
    Vector3 wallAttachPos;

    bool didDeathCam;
    int deathCamTics;

    double wobbleDir;
    double targetPitch;
    double targetYaw;
    double targetRoll;

    bool isSliding;
    int slideTics;
    int slideCooldown;
    double normalHeight;
    double normalViewHeight;

    // ---------- QUAKE MOVEMENT / BOBBING VARIABLES ----------
    double bobCounter;
    double viewChange;   // smoothly interpolated final camera offset
    double landOffset;   // landing “thud” offset
    double rollAngle;    // strafe tilt
    bool lastOnground;   // previous frame onground state (from engine)
    bool lastJump;       // previous frame jump button state (for tap detection)
    int coyoteTimer;     // ticks remaining for coyote jump
    bool hasJumped;      // true if we already jumped this air trip

    // ----------------------------------------------------
    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        normalHeight = Default.Height;
        normalViewHeight = Default.ViewHeight;
        lastJump = false;
        coyoteTimer = 0;
        hasJumped = false;
    }

    // ---------- COMPLETELY DISABLE ENGINE JUMP ----------
    override void CheckJump()
    {
        // intentionally empty – we handle jumping ourselves
    }

    // ---------- MAIN TICK (unchanged from original SF_Player) ----------
    override void Tick()
    {
        Super.Tick();

        // Cooldown timer
        if (slideCooldown > 0)
            slideCooldown--;

        // Detect crouch slide
        bool crouching = (GetCrouchFactor() < 1.0);
        double speed2D = sqrt(vel.x * vel.x + vel.y * vel.y);

        if (!isSliding && slideCooldown <= 0 && crouching && speed2D > 12)
        {
            StartSlide();
        }

        // Sliding behaviour
        if (isSliding)
        {
            slideTics--;

            // Slight momentum preservation
            vel.x *= 0.98;
            vel.y *= 0.98;

            if (slideTics <= 0)
            {
                EndSlide();
            }
        }

        // Wall logic (unchanged)
        if (GetCrouchFactor() == 0.5)
        {
            GiveInventory("CrochProt_Giver", 1);
        }

        if (player.cmd.buttons & BT_USE)
        {
            if (!isUsing)
            {
                if (!isWallAttached)
				{
					FLineTraceData LedgeTrace;
					double TraceDistance = sqrt(2) * Radius + 1;
					LineTrace(angle, TraceDistance, 0, TRF_BLOCKSELF|TRF_THRUACTORS, Height * 1.2, data: LedgeTrace);

					if (LedgeTrace.HitType == TRACE_HitWall)
					{
						if (LedgeTrace.HitTexture == TexMan.CheckForTexture("WALLJUMP", TexMan.Type_Wall))
						{
							isWallAttached = true;
							wallAttachPos = pos;
							vel = (0, 0, 0);
							bNoGravity = true;
						}
					}
				}
                else
                {
                    isWallAttached = false;
                    bNoGravity = false;
                    Vector2 jumpDir2 = AngleToVector(angle);
                    double jumpStrength = 36.0;
                    vel = (jumpDir2.x * jumpStrength, jumpDir2.y * jumpStrength, JumpZ * 1.15);
                }
            }
            isUsing = true;
        }
        else
        {
            isUsing = false;
        }
    }

    // ---------- SLIDE FUNCTIONS (unchanged) ----------
    void StartSlide()
    {
        isSliding = true;
        slideTics = 20;
        slideCooldown = 105;

        Vector2 dir = AngleToVector(angle);
        double boost = 400.0;

        vel.x += dir.x * boost;
        vel.y += dir.y * boost;

        height = normalHeight * 0.25;
        ViewHeight = normalViewHeight * 0.25;

        A_StartSound("player/slide", CHAN_BODY);
    }

    void EndSlide()
    {
        isSliding = false;
        height = normalHeight;
        ViewHeight = normalViewHeight;
    }

    // ---------- QUAKE MOVEMENT & BOBBING (fully integrated, with coyote time) ----------
    override void MovePlayer()
    {
        let player = self.player;
        if (!player) return;

        // Wall / slide lockdowns – no manual movement
        if (isWallAttached)
        {
            vel = (0,0,0);
            player.cmd.forwardmove = 0;
            player.cmd.sidemove = 0;
            Super.MovePlayer();
            lastJump = false;
            return;
        }

        if (isSliding)
        {
            player.cmd.forwardmove = 0;
            player.cmd.sidemove = 0;
            Super.MovePlayer();
            lastJump = false;
            return;
        }

        double fm = player.cmd.forwardmove;
        double sm = player.cmd.sidemove;
        double maxSpeed = 12.0 * Speed;

        bool grounded = player.onground;

        // ---------- COYOTE TIME MANAGEMENT ----------
        if (grounded)
        {
            // Reset all air‑trip flags when back on ground
            hasJumped = false;
            coyoteTimer = 0;
        }
        else
        {
            // Decrement coyote timer (never below 0)
            if (coyoteTimer > 0)
                coyoteTimer--;
        }

        // Landing thud
        if (grounded && !lastOnground && vel.z < -2.0)
        {
            landOffset = clamp(vel.z * 0.8, -12.0, 0);
        }

        // ---------- TAP TO JUMP WITH COYOTE TIME ----------
        bool jumpPressed = (player.cmd.buttons & BT_JUMP) != 0;
        bool jumpEdge = jumpPressed && !lastJump;   // rising edge

        // Jump conditions: rising edge AND (on ground OR within coyote time) AND haven’t jumped this air trip
        if (jumpEdge && (grounded || coyoteTimer > 0) && !hasJumped)
        {
            vel.z = JumpZ;                 // direct vertical impulse
            landOffset = 3.0;              // small view kick

            // Remove the jump button this tick so nothing else sees it
            player.cmd.buttons &= ~BT_JUMP;

            // Mark that we’ve jumped – no more jumps until landing
            hasJumped = true;
            coyoteTimer = 0;               // cancel remaining coyote time
        }

        // If we’ve just left the ground (walking off a ledge)
        // and we haven’t jumped yet, start the coyote grace period.
        if (lastOnground && !grounded && !hasJumped)
        {
            coyoteTimer = 7; // about 0.1 seconds
        }

        // Store states for next tick
        lastJump = jumpPressed;
        lastOnground = grounded;

        // Zero input so engine doesn’t interfere
        player.cmd.forwardmove = 0;
        player.cmd.sidemove = 0;

        // Stop instantly on ground when no keys pressed
        if (fm == 0 && sm == 0)
        {
            if (grounded)
            {
                vel.x = 0;
                vel.y = 0;
            }
        }
        else
        {
            // ---------- FIXED WISH DIRECTION (RIGHT = RIGHT, LEFT = LEFT) ----------
            double wishX = cos(angle) * fm + sin(angle) * sm;
            double wishY = sin(angle) * fm - cos(angle) * sm;

            double wishLen = sqrt(wishX * wishX + wishY * wishY);
            if (wishLen > 0)
            {
                wishX /= wishLen;
                wishY /= wishLen;
            }

            // Apply speed instantly (replace with acceleration for Quake™ feel)
            if (grounded || (vel.x*vel.x + vel.y*vel.y) <= (maxSpeed*maxSpeed))
            {
                vel.x = wishX * maxSpeed;
                vel.y = wishY * maxSpeed;
            }
        }

        Super.MovePlayer();

        // Restore input for bob/hud
        player.cmd.forwardmove = fm;
        player.cmd.sidemove = sm;

        // ---------- VIEW BOBBING & ROLL ----------
        double horizontalSpeed = vel.xy.length();
        double targetBob = 0;

        if (grounded && horizontalSpeed > 0.1)
        {
            bobCounter += horizontalSpeed * 1.4;
            double bobIntensity = horizontalSpeed * 0.3;
            targetBob = Sin(bobCounter) * bobIntensity;
            player.bob = bobIntensity * 1.2;

            double targetRoll = 0;
            if (sm > 0) targetRoll = 1.2;
            else if (sm < 0) targetRoll = -1.2;
            rollAngle = (rollAngle * 0.9) + (targetRoll * 0.1);
        }
        else
        {
            bobCounter = 0;
            player.bob *= 0.8;
            rollAngle *= 0.8;
        }

        landOffset *= 0.85;
        double combinedOffset = targetBob + landOffset;
        viewChange = (viewChange * 0.7) + (combinedOffset * 0.3);
        player.viewheight = Default.ViewHeight + viewChange;
        A_SetRoll(rollAngle, SPF_INTERPOLATE);
    }
}

// ---------- CROUCH PROTECTION POWERUPS (unchanged) ----------
Class CrochProt_Giver : PowerupGiver
{
    Default
    {
        Powerup.Type "PowerCrochProt";
        +INVENTORY.AUTOACTIVATE;
    }
}

Class PowerCrochProt : PowerProtection
{
    Default
    {
        Powerup.Duration 1;
        DamageFactor "Normal", 0.5;
    }
}