class SF_Player : DoomPlayer
{
    Default
    {
        Speed 1.0;
        Radius 16;
        Height 56;
        Player.JumpZ 9.1;

        Player.TeleportFreezeTime 6;
        Player.DisplayName "Karl";
        Player.StartItem "SF_Axe";

        Player.WeaponSlot 1, "SF_Axe", "SF_RipSaw";
        Player.WeaponSlot 2, "SF_NOVA";
        Player.WeaponSlot 3, "SF_Slugger", "SF_Dominatus";
        Player.WeaponSlot 4, "SF_Viper";
        Player.WeaponSlot 5, "SF_SpeedHucker";

        DamageFactor "NODAMAGEPLAYER", 0;
        Player.ViewBob 0; // we do our own view bob
    }

    // ---------- WALLJUMP & CROUCH ----------
    bool isUsing;
    bool isWallAttached;
    Vector3 wallAttachPos;

    // ---------- VIEW BOBBING / KICKS ----------
    double currentBaseView;
    double bobCounter;
    double bobValue;
    double jumpBob;        // upward kick on jump
    double landOffset;     // downward dip on landing
    double rollAngle;

    // ---------- JUMP CONTROL ----------
    bool lastJump;
    bool hasJumped;
    bool lastOnground;

    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        lastJump    = false;
        hasJumped   = false;
        lastOnground = true;
        currentBaseView = Default.ViewHeight;
    }

    // Disable the engine’s own jump
    override void CheckJump() {}

    override void Tick()
    {
        Super.Tick();

        A_LogInt(vel.x);
        A_LogInt(vel.y);
        A_LogInt(vel.z);
        A_Log("");

        // Crouch protection
        if (GetCrouchFactor() == 0.5)
            GiveInventory("CrochProt_Giver", 1);

        // Wall‑jump handling
        if (player.cmd.buttons & BT_USE)
        {
            if (!isUsing)
            {
                if (!isWallAttached)
                {
                    FLineTraceData LedgeTrace;
                    double TraceDistance = sqrt(2) * Radius + 1;
                    LineTrace(angle, TraceDistance, 0, TRF_BLOCKSELF|TRF_THRUACTORS, Height * 1.2, data: LedgeTrace);
                    if (LedgeTrace.HitType == TRACE_HitWall &&
                        LedgeTrace.HitTexture == TexMan.CheckForTexture("WALLJUMP", TexMan.Type_Wall))
                    {
                        isWallAttached = true;
                        wallAttachPos = pos;
                        vel = (0,0,0);
                        bNoGravity = true;
                    }
                }
                else
                {
                    isWallAttached = false;
                    bNoGravity = false;
                    Vector2 dir = AngleToVector(angle);
                    vel = (dir.x * 32.0, dir.y * 32.0, JumpZ * 1.25);
                    hasJumped = true;
                }
            }
            isUsing = true;
        }
        else isUsing = false;
    }

    // ---------- CORE MOVEMENT ----------
    override void MovePlayer()
    {
        let player = self.player;
        if (!player) return;

        // ----- WALL JUMP -----
        if (isWallAttached)
        {
            vel = (0,0,0);
            double oldFM = player.cmd.forwardmove;
            double oldSM = player.cmd.sidemove;
            player.cmd.forwardmove = 0;
            player.cmd.sidemove   = 0;
            Super.MovePlayer();
            player.cmd.forwardmove = oldFM;
            player.cmd.sidemove   = oldSM;
            lastJump = false;
            return;
        }

        double fm = player.cmd.forwardmove;
        double sm = player.cmd.sidemove;
        double crouchFactor = GetCrouchFactor();

        // ---- CROUCH ----
        double speedMult = (crouchFactor >= 1.0) ? 1.0 : 0.25;
        double maxSpeed  = 13.0 * Speed * speedMult;

        bool wasOnGround = player.onground;

        // Reset the jump flag only when you land
        if (wasOnGround)
            hasJumped = false;


        bool jumpPressed = (player.cmd.buttons & BT_JUMP) != 0;
        bool jumpEdge    = jumpPressed && !lastJump;

        if (jumpEdge && wasOnGround && !hasJumped)
        {
            vel.z = JumpZ;
            vel.xy *= 1.35; // multiplicative speed boost

            jumpBob   = 20.0;
            hasJumped = true;

            A_StartSound("player/jump", CHAN_AUTO, volume: 0.7);
        }
        lastJump = jumpPressed;

        // Save vertical speed before physics for landing detection
        double preMoveVelZ = vel.z;

        player.cmd.forwardmove = 0;
        player.cmd.sidemove   = 0;

        double wishX = cos(angle) * fm + sin(angle) * sm;
        double wishY = sin(angle) * fm - cos(angle) * sm;
        double wishLen = sqrt(wishX*wishX + wishY*wishY);
        if (wishLen > 0) { wishX /= wishLen; wishY /= wishLen; }

        // ----- Ground movement -----
        if (wasOnGround)
        {
            if (fm == 0 && sm == 0)
            {
                vel.x *= 0.81;
                vel.y *= 0.81;
                if (abs(vel.x) < 0.1) vel.x = 0;
                if (abs(vel.y) < 0.1) vel.y = 0;
            }
            else
            {
                // Current speed in the wish direction
                double curSpeedInWish = vel.x * wishX + vel.y * wishY;

                // Only accelerate if below the max allowed speed (preserving overspeed)
                if (curSpeedInWish < maxSpeed)
                {
                    double accel = 6.0 * speedMult; // acceleration scaled with crouch
                    vel.x += wishX * accel;
                    vel.y += wishY * accel;
                }

                // Hard cap to avoid truly infinite speeds (If J wants this can be removed)
                double maxHardSpeed = 50.0;
                double curSpeed = vel.xy.length();
                if (curSpeed > maxHardSpeed)
                    vel.xy = vel.xy / curSpeed * maxHardSpeed;
            }
        }
        else // Air movement
        {
            if (fm != 0 || sm != 0)
            {
                // Add a small constant acceleration in the wish direction
                double airAccel = 1.25;
                vel.x += wishX * airAccel;
                vel.y += wishY * airAccel;

                // Optional hard cap to keep speeds reasonable
                double maxAirSpeed = 50.0;
                double curSpeed = vel.xy.length();
                if (curSpeed > maxAirSpeed)
                    vel.xy = vel.xy / curSpeed * maxAirSpeed;
            }
        }

        // Engine resolves collisions, stairs, etc.
        Super.MovePlayer();

        // ----- Landing camera dip -----
        if (player.onground && !wasOnGround && preMoveVelZ < -5.0)
        {
            landOffset = clamp(preMoveVelZ * 1.5, -35.0, 0);
            A_StartSound("player/land", CHAN_AUTO, volume: 0.8);
        }

        lastOnground = player.onground;

        // Restore original input
        player.cmd.forwardmove = fm;
        player.cmd.sidemove   = sm;

        // ----- View bob / roll / decay -----
        double hSpeed = vel.xy.length();
        if (hSpeed > 0.1 && player.onground)
            bobCounter += hSpeed * 1.1;

        bobValue = sin(bobCounter) * (hSpeed * 0.15);

        double tRoll = (sm > 0) ? 1.5 : (sm < 0) ? -1.5 : 0;
        rollAngle = rollAngle * 0.9 + tRoll * 0.1;

        jumpBob    *= 0.6;
        landOffset *= 1.3;

        A_SetRoll(rollAngle, SPF_INTERPOLATE);
    }

    // ---------- VIEW HEIGHT OVERRIDE ----------
    override void CalcHeight()
    {
        Super.CalcHeight();

        double targetBaseView = player.viewheight;
        currentBaseView = (currentBaseView * 0.6) + (targetBaseView * 0.4);

        player.viewheight = currentBaseView + bobValue + jumpBob + landOffset;
        player.viewz = pos.z + player.viewheight;
    }
}

// ---------- CROUCH PROTECTION ----------
Class CrochProt_Giver : PowerupGiver
{
    Default
    {
        Powerup.Type "PowerCrochProt";
        +INVENTORY.AUTOACTIVATE;
    }
}

Class PowerCrochProt : PowerProtection
{
    Default
    {
        Powerup.Duration 1;
        DamageFactor "Normal", 0.5;
    }
}