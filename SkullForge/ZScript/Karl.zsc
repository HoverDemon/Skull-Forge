class SF_Player : DoomPlayer
{
    Default
    {
        Speed 0.8;
        Radius 16;
        Height 56;
        Player.JumpZ 9.1;

        Player.TeleportFreezeTime 6;
        Player.DisplayName "Karl";
        Player.StartItem "SF_Axe";

        Player.WeaponSlot 1, "SF_Axe", "SF_RipSaw";
        Player.WeaponSlot 2, "SF_NOVA";
        Player.WeaponSlot 3, "SF_Slugger", "SF_Dominatus";
        Player.WeaponSlot 4, "SF_Viper";
        Player.WeaponSlot 5, "SF_SpeedHucker";

        DamageFactor "NODAMAGEPLAYER", 0;
        Player.ViewBob 0;
    }

    // ---------- WALLJUMP ----------
    bool isUsing;
    bool isWallAttached;
    Vector3 wallAttachPos;

    // ---------- SLIDE ----------
    bool isSliding;
    bool lastCrouch;

    double slideTimer;
    double topSpeedTimer;

    double slideDirX;
    double slideDirY;

    // ---------- VIEW ----------
    double currentBaseView;
    double bobCounter;
    double bobValue;
    double jumpBob;
    double landOffset;
    double rollAngle;

    // ---------- JUMP ----------
    bool lastJump;
    bool hasJumped;
    bool lastOnground;

    override void PostBeginPlay()
    {
        Super.PostBeginPlay();

        lastJump = false;
        hasJumped = false;
        lastOnground = true;

        currentBaseView = Default.ViewHeight;

        isSliding = false;
        lastCrouch = false;

        slideTimer = 0;
        topSpeedTimer = 0;

        slideDirX = 0;
        slideDirY = 0;
    }

    override void CheckJump() {}

    override void Tick()
    {
        Super.Tick();

        // Crouch protection
        if (GetCrouchFactor() == 0.5)
            GiveInventory("CrochProt_Giver", 1);

        // ---------- WALL JUMP ----------
        if (player.cmd.buttons & BT_USE)
        {
            if (!isUsing)
            {
                if (!isWallAttached)
                {
                    FLineTraceData LedgeTrace;

                    double TraceDistance =
                        sqrt(2) * Radius + 1;

                    LineTrace(
                        angle,
                        TraceDistance,
                        0,
                        TRF_BLOCKSELF | TRF_THRUACTORS,
                        Height * 1.2,
                        data: LedgeTrace
                    );

                    if (
                        LedgeTrace.HitType == TRACE_HitWall &&
                        LedgeTrace.HitTexture ==
                        TexMan.CheckForTexture(
                            "WALLJUMP",
                            TexMan.Type_Wall
                        )
                    )
                    {
                        isWallAttached = true;
                        wallAttachPos = pos;

                        vel = (0,0,0);
                        bNoGravity = true;
                    }
                }
                else
                {
                    isWallAttached = false;
                    bNoGravity = false;

                    Vector2 dir = AngleToVector(angle);

                    vel =
                    (
                        dir.x * 32.0,
                        dir.y * 32.0,
                        JumpZ * 1.25
                    );

                    hasJumped = true;
                }
            }

            isUsing = true;
        }
        else
        {
            isUsing = false;
        }
    }

    override void MovePlayer()
    {
        let player = self.player;

        if (!player)
            return;

        // ---------- WALL ATTACH ----------
        if (isWallAttached)
        {
            vel = (0,0,0);

            double oldFM = player.cmd.forwardmove;
            double oldSM = player.cmd.sidemove;

            player.cmd.forwardmove = 0;
            player.cmd.sidemove = 0;

            Super.MovePlayer();

            player.cmd.forwardmove = oldFM;
            player.cmd.sidemove = oldSM;

            lastJump = false;
            return;
        }

        double fm = player.cmd.forwardmove;
        double sm = player.cmd.sidemove;

        // ---------- CROUCH ----------
        double crouchFactor =
            isSliding ? 0.5 : GetCrouchFactor();

        bool crouching =
            (player.cmd.buttons & BT_CROUCH) != 0
            || isSliding;

        bool crouchPressed = crouching;

        bool crouchEdge =
            crouchPressed && !lastCrouch;

        double speedMult =
            crouching ? 0.25 : 1.0;

        double maxSpeed =
            13.0 * Speed * speedMult;

        bool wasOnGround = player.onground;

        // ---------- RESET JUMP ----------
        if (wasOnGround)
            hasJumped = false;

        // ---------- JUMP ----------
        bool jumpPressed =
            (player.cmd.buttons & BT_JUMP) != 0;

        bool jumpEdge =
            jumpPressed && !lastJump;

        if (
            jumpEdge &&
            wasOnGround &&
            !hasJumped
        )
        {
            vel.z = JumpZ;

            // Bunnyhop boost
            vel.xy *= 1.35;

            jumpBob = 20.0;

            hasJumped = true;

            A_StartSound(
                "player/jump",
                CHAN_AUTO,
                volume: 0.7
            );
        }

        lastJump = jumpPressed;

        double preMoveVelZ = vel.z;

        player.cmd.forwardmove = 0;
        player.cmd.sidemove = 0;

        // ---------- WISHDIR ----------
        double wishX =
            cos(angle) * fm +
            sin(angle) * sm;

        double wishY =
            sin(angle) * fm -
            cos(angle) * sm;

        double wishLen =
            sqrt(
                wishX * wishX +
                wishY * wishY
            );

        if (wishLen > 0)
        {
            wishX /= wishLen;
            wishY /= wishLen;
        }

        double curSpeed = vel.xy.length();

        // ---------- TOP SPEED TIMER ----------
        if (curSpeed >= 12.0)
            topSpeedTimer += 1.0 / 35.0;
        else
            topSpeedTimer = 0;

        // ---------- START SLIDE ----------
        if (
            !isSliding &&
            crouchEdge &&
            topSpeedTimer >= 0.5
        )
        {
            isSliding = true;

            slideTimer = 1.0;

            if (curSpeed > 0.01)
            {
                slideDirX = vel.x / curSpeed;
                slideDirY = vel.y / curSpeed;
            }

            // +150% speed boost
            vel.x += slideDirX * (curSpeed * 1.5);
            vel.y += slideDirY * (curSpeed * 1.5);

            player.cmd.buttons |= BT_CROUCH;

            A_StartSound(
                "player/slide",
                CHAN_AUTO,
                volume: 0.9
            );
        }

        lastCrouch = crouchPressed;

        // ---------- SLIDE ----------
        if (isSliding)
        {
            slideTimer -= 1.0 / 35.0;

            // HARD FORCE CROUCH
            player.cmd.buttons |= BT_CROUCH;
            player.crouchfactor = 0.5;

            // Momentum preservation
            vel.x += slideDirX * 0.55;
            vel.y += slideDirY * 0.55;

            // Friction
            double slideFriction =
                player.onground ? 0.994 : 0.999;

            vel.x *= slideFriction;
            vel.y *= slideFriction;

            // Steering
            if (wishLen > 0)
            {
                vel.x += wishX * 0.14;
                vel.y += wishY * 0.14;
            }

            // End conditions
            if (
                slideTimer <= 0 ||
                vel.xy.length() < 8.0
            )
            {
                isSliding = false;
            }
        }

        // ---------- GROUND ----------
        else if (wasOnGround)
        {
            if (fm == 0 && sm == 0)
            {
                vel.x *= 0.81;
                vel.y *= 0.81;

                if (abs(vel.x) < 0.1)
                    vel.x = 0;

                if (abs(vel.y) < 0.1)
                    vel.y = 0;
            }
            else
            {
                double curSpeedInWish =
                    vel.x * wishX +
                    vel.y * wishY;

                if (curSpeedInWish < maxSpeed)
                {
                    double accel =
                        6.0 * speedMult;

                    vel.x += wishX * accel;
                    vel.y += wishY * accel;
                }

                double maxHardSpeed = 50.0;

                double totalSpeed =
                    vel.xy.length();

                if (totalSpeed > maxHardSpeed)
                {
                    vel.xy =
                        vel.xy /
                        totalSpeed *
                        maxHardSpeed;
                }
            }
        }

        // ---------- AIR ----------
        else
        {
            if (fm != 0 || sm != 0)
            {
                // Side movement weaker
                double sideScale = 0.65;

                double airWishX =
                    cos(angle) * fm +
                    sin(angle) * (sm * sideScale);

                double airWishY =
                    sin(angle) * fm -
                    cos(angle) * (sm * sideScale);

                double airWishLen =
                    sqrt(
                        airWishX * airWishX +
                        airWishY * airWishY
                    );

                if (airWishLen > 0)
                {
                    airWishX /= airWishLen;
                    airWishY /= airWishLen;
                }

                // Air cap
                double airMaxSpeed = 16.0;

                // Current speed in direction
                double currentSpeed =
                    vel.x * airWishX +
                    vel.y * airWishY;

                double addSpeed =
                    airMaxSpeed -
                    currentSpeed;

                if (addSpeed > 0)
                {
                    double airAccel = 0.85;

                    if (airAccel > addSpeed)
                        airAccel = addSpeed;

                    vel.x += airWishX * airAccel;
                    vel.y += airWishY * airAccel;
                }

                // Hard cap
                double hardCap = 50.0;

                double totalSpeed =
                    vel.xy.length();

                if (totalSpeed > hardCap)
                {
                    vel.xy =
                        vel.xy /
                        totalSpeed *
                        hardCap;
                }
            }
        }

        // ---------- ENGINE MOVE ----------
        Super.MovePlayer();

        // ---------- LAND ----------
        if (
            player.onground &&
            !wasOnGround &&
            preMoveVelZ < -5.0
        )
        {
            landOffset =
                clamp(
                    preMoveVelZ * 1.5,
                    -35.0,
                    0
                );

            A_StartSound(
                "player/land",
                CHAN_AUTO,
                volume: 0.8
            );
        }

        lastOnground = player.onground;

        // Restore inputs
        player.cmd.forwardmove = fm;
        player.cmd.sidemove = sm;

        // ---------- VIEW BOB ----------
        double hSpeed =
            vel.xy.length();

        if (
            hSpeed > 0.1 &&
            player.onground
        )
        {
            bobCounter += hSpeed * 1.1;
        }

        bobValue =
            sin(bobCounter) *
            (hSpeed * 0.15);

        // ---------- ROLL ----------
        double tRoll;

        if (isSliding)
        {
            tRoll = 4.0;
        }
        else
        {
            tRoll =
                (sm > 0) ? 1.5 :
                (sm < 0) ? -1.5 :
                0;
        }

        rollAngle =
            rollAngle * 0.9 +
            tRoll * 0.1;

        jumpBob *= 0.6;
        landOffset *= 1.3;

        A_SetRoll(
            rollAngle,
            SPF_INTERPOLATE
        );
    }

    // ---------- CAMERA ----------
    override void CalcHeight()
    {
        Super.CalcHeight();

        double targetBaseView =
            player.viewheight;

        currentBaseView =
            (currentBaseView * 0.6) +
            (targetBaseView * 0.4);

        player.viewheight =
            currentBaseView +
            bobValue +
            jumpBob +
            landOffset;

        player.viewz =
            pos.z +
            player.viewheight;
    }
}

// ---------- CROUCH PROTECTION ----------
Class CrochProt_Giver : PowerupGiver
{
    Default
    {
        Powerup.Type "PowerCrochProt";
        +INVENTORY.AUTOACTIVATE;
    }
}

Class PowerCrochProt : PowerProtection
{
    Default
    {
        Powerup.Duration 1;
        DamageFactor "Normal", 0.5;
    }
}