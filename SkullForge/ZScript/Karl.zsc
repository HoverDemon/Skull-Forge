Class SF_Player : DoomPlayer
{
    Default
    {
        Speed 1.25;
        Radius 16;
        Height 56;
        Player.JumpZ 9.0;

        Player.TeleportFreezeTime 6;
        Player.DisplayName "Karl";
        Player.StartItem "SF_Axe";

        Player.WeaponSlot 1, "SF_Axe", "SF_RipSaw";
        Player.WeaponSlot 2, "SF_NOVA";
        Player.WeaponSlot 3, "SF_Slugger", "SF_Dominatus";
        Player.WeaponSlot 4, "SF_Viper";
        Player.WeaponSlot 5, "SF_SpeedHucker";

        DamageFactor "NODAMAGEPLAYER", 0;
        Player.ViewBob 0; // We handle our own bob
    }

    // ---------- ORIGINAL VARIABLES ----------
    bool isUsing;
    bool isWallAttached;
    Vector3 wallAttachPos;

    bool didDeathCam;
    int deathCamTics;

    double wobbleDir;
    double targetPitch;
    double targetYaw;
    double targetRoll;

    bool isSliding;
    int slideTics;
    int slideCooldown;
    double normalHeight;
    double normalViewHeight;

    // ---------- MOVEMENT / BOBBING ----------
    double bobCounter;
    double bobValue;     // Current heavy step bob offset
    double landOffset;   // Landing thud
    double jumpBob;      // Jump upward kick
    double rollAngle;    // Strafe tilt
    bool lastOnground;   // Previous tick onground
    bool lastJump;       // Previous tick jump button
    int coyoteTimer;     // Ticks of grace after leaving ground
    bool hasJumped;      // True if a jump was made this air trip
    
    int jumpBoostTimer;      // Tracks the 1-tick delay for the forward boost
    double currentBaseView;  // Smoothly tracks intended view height 

    override void PostBeginPlay()
    {
        Super.PostBeginPlay();
        normalHeight = Default.Height;
        normalViewHeight = Default.ViewHeight;
        lastJump = false;
        coyoteTimer = 0;
        hasJumped = false;
        
        currentBaseView = Default.ViewHeight;
    }

    // Disable the engine’s own jump logic
    override void CheckJump() {}

    override void Tick()
    {
        Super.Tick();

        if (slideCooldown > 0) slideCooldown--;

        bool crouching = (GetCrouchFactor() < 1.0);
        double speed2D = vel.xy.length();

        if (!isSliding && slideCooldown <= 0 && crouching && speed2D > 12)
            StartSlide();

        if (isSliding)
        {
            slideTics--;
            vel.x *= 0.98;
            vel.y *= 0.98;
            if (slideTics <= 0) EndSlide();
        }

        if (GetCrouchFactor() == 0.5)
            GiveInventory("CrochProt_Giver", 1);

        if (player.cmd.buttons & BT_USE)
        {
            if (!isUsing)
            {
                if (!isWallAttached)
                {
                    FLineTraceData LedgeTrace;
                    double TraceDistance = sqrt(2) * Radius + 1;
                    LineTrace(angle, TraceDistance, 0, TRF_BLOCKSELF|TRF_THRUACTORS, Height * 1.2, data: LedgeTrace);
                    if (LedgeTrace.HitType == TRACE_HitWall &&
                        LedgeTrace.HitTexture == TexMan.CheckForTexture("WALLJUMP", TexMan.Type_Wall))
                    {
                        isWallAttached = true;
                        wallAttachPos = pos;
                        vel = (0,0,0);
                        bNoGravity = true;
                    }
                }
                else
                {
                    isWallAttached = false;
                    bNoGravity = false;
                    Vector2 dir = AngleToVector(angle);
                    vel = (dir.x * 32.0, dir.y * 32.0, JumpZ * 1.25);
                    hasJumped = true;   
                }
            }
            isUsing = true;
        }
        else isUsing = false;
    }

    void StartSlide()
    {
        isSliding = true;
        slideTics = 20;
        slideCooldown = 105;
        Vector2 dir = AngleToVector(angle);
        vel.x += dir.x * 400.0;
        vel.y += dir.y * 400.0;
        height = normalHeight * 0.25;
        A_StartSound("player/slide", CHAN_BODY);
    }

    void EndSlide()
    {
        isSliding = false;
        height = normalHeight;
    }

    // ---------- CORE MOVEMENT ----------
    override void MovePlayer()
    {
        let player = self.player;
        if (!player) return;

        // --- LOCKDOWNS ---
        if (isWallAttached || isSliding)
        {
            if (isWallAttached) vel = (0,0,0);
            double oldFM = player.cmd.forwardmove;
            double oldSM = player.cmd.sidemove;
            player.cmd.forwardmove = 0; player.cmd.sidemove = 0;
            Super.MovePlayer();
            player.cmd.forwardmove = oldFM; player.cmd.sidemove = oldSM;
            lastJump = false;
            return;
        }

        double fm = player.cmd.forwardmove;
        double sm = player.cmd.sidemove;
        double crouchFactor = GetCrouchFactor();
        double maxSpeed = 13.0 * Speed * crouchFactor;
        
        bool wasOnGround = player.onground;
        
        // --- COYOTE TIME ---
        if (wasOnGround)
        {
            hasJumped = false;
            coyoteTimer = 6;
        }
        else
        {
            if (coyoteTimer > 0) coyoteTimer--;
        }

        // --- JUMPING ---
        bool jumpPressed = (player.cmd.buttons & BT_JUMP) != 0;
        bool jumpEdge = jumpPressed && !lastJump;

        if (jumpEdge && (wasOnGround || coyoteTimer > 0) && !hasJumped)
        {
            vel.z = JumpZ;
            jumpBoostTimer = 2;  
            
            // Set the raw impulse for the kick
            jumpBob = 20.0;              
            A_StartSound("player/jump", CHAN_AUTO, volume: 0.7);

            hasJumped = true;
            coyoteTimer = 0;
        }

        lastJump = jumpPressed;

        // --- ENGINE INPUT BYPASS ---
        player.cmd.forwardmove = 0;
        player.cmd.sidemove = 0;

        double wishX = cos(angle) * fm + sin(angle) * sm;
        double wishY = sin(angle) * fm - cos(angle) * sm;
        double wishLen = sqrt(wishX*wishX + wishY*wishY);
        if (wishLen > 0) { wishX /= wishLen; wishY /= wishLen; }

        if (wasOnGround)
        {
            if (fm == 0 && sm == 0)
            {
                vel.xy = (0,0);         
            }
            else
            {
                vel.x = wishX * maxSpeed;
                vel.y = wishY * maxSpeed;
            }
        }
        else
        {
            if (fm != 0 || sm != 0)
            {
                double airAccel = 0.06;
                vel.x += (wishX * maxSpeed - vel.x) * airAccel;
                vel.y += (wishY * maxSpeed - vel.y) * airAccel;
            }
        }

        if (jumpBoostTimer > 0)
        {
            jumpBoostTimer--;
            if (jumpBoostTimer == 0)
            {
                vel.x += cos(angle) * 3.0;
                vel.y += sin(angle) * 3.0;
            }
        }

        double preMoveVelZ = vel.z;

        // Engine resolves collisions and onground status here
        Super.MovePlayer();

        // --- LANDING KICK ---
        if (player.onground && !wasOnGround && preMoveVelZ < -5.0)
        {
            landOffset = clamp(preMoveVelZ * 1.5, -35.0, 0);
            A_StartSound("player/land", CHAN_AUTO, volume: 0.8);
        }

        lastOnground = player.onground;
        player.cmd.forwardmove = fm;
        player.cmd.sidemove = sm;

        // --- BOB / ROLL / DECAY CALCULATIONS ---
        double hSpeed = vel.xy.length();
        if (hSpeed > 0.1 && player.onground)
        {
            bobCounter += hSpeed * 1.1;
        }
        
        bobValue = sin(bobCounter) * (hSpeed * 0.15);
        
        double tRoll = (sm > 0) ? 1.5 : (sm < 0) ? -1.5 : 0;
        rollAngle = (rollAngle * 0.9) + (tRoll * 0.1);

        // Decay the kicks every tick so they return to normal
        jumpBob *= 0.6;
        landOffset *= 1.3;

        A_SetRoll(rollAngle, SPF_INTERPOLATE);
    }

    // ---------- VIEW KICK AND BOB OVERRIDE ----------
    override void CalcHeight()
    {
        Super.CalcHeight(); 

        double targetBaseView = isSliding ? (normalViewHeight * 0.25) : player.viewheight;
        currentBaseView = (currentBaseView * 0.6) + (targetBaseView * 0.4);

        player.viewheight = currentBaseView + bobValue + jumpBob + landOffset;
        player.viewz = pos.z + player.viewheight;
    }
}

// ---------- CROUCH PROTECTION ----------
Class CrochProt_Giver : PowerupGiver
{
    Default
    {
        Powerup.Type "PowerCrochProt";
        +INVENTORY.AUTOACTIVATE;
    }
}

Class PowerCrochProt : PowerProtection
{
    Default
    {
        Powerup.Duration 1;
        DamageFactor "Normal", 0.5;
    }
}