{
    // Map custom file extensions to language ids. This maps .vgxhv to the ZScript language
    "files.associations": {
        "*.zcs": "zscript",
        "*.map": "mapinfo",
        "*.dec": "decorate",
        "SNDINFO.*": "sndinfo",
        "gldefs.*": "gldefs",
        "TRNSLATE.*" : "Trnslate",
        "animdefs.*" : "animdefs",
        "*.iwad": "iwadinfo",
        "*.game": "gameinfo",
        "LOCKDEFS.*": "lockdefs"
    }
}