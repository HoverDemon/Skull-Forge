Actor SF_BlueEntryCard : Key 5
{
    //$Title Blue Entry Card
    //$Category Keys
    //$Colour 13
    //$Sprite BPCRA0
    //$NotAngled
    +Bright
    Inventory.PickupMessage "\ctKEY AQUIRED: \chBlue Entry Card"
    States
    {
        Spawn:
            BPCR AB 6
            BPCR CDEF 4
            BPCR HI 6
            Loop
    }
}

