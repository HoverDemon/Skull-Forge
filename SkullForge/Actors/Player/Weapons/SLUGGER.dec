ACTOR SF_Slugger : WF_WeaponBase 2001
{
	//$Title M-19 Slugger
	//$Sprite SHOTA0
	//$Category Weapons
	//$Colour 14
	Weapon.SelectionOrder 1300
	Weapon.AmmoUse 1
	Weapon.AmmoGive 8
	Weapon.AmmoType "SF_Shells"
	Obituary "\cb%o \umhas a bowling ball sized hole in his chest by \cr%k's \cmM-19."
	Inventory.Pickupmessage "\cqWEAPON AQUIRED: \cbM-19 Slugger \c*(SLOT 3)"
	Tag "M-19 Slugger"
	Inventory.PickupSound "weapons/slugger/up"
	Weapon.KickBack 100
	States
	{
		Deselect:
			TNT1 A 0 A_PlaySound("weapons/slugger/down",CHAN_6)
			SLUG A 1 Offset(0,32)
			SLUG A 1 Offset(-8,48)
			SLUG A 1 Offset(-16,64)
			SLUG A 1 Offset(-24,72)
			SLUG A 1 Offset(-32,86)
			SLUG A 1 Offset(-48,96)
			SLUG A 1 Offset(-52,112)
			SLUG A 1 Offset(-64,128)
		ReadlDeselect:
			TNT1 A 0 A_Lower
			Loop
		Select:
			TNT1 A 0 A_Raise
			Loop
			
		Ready:
			TNT1 A 0 A_PlaySound("weapons/slugger/up",CHAN_6)
			SLUG A 1 Offset(-64,128)
			SLUG A 1 Offset(-52,112)
			SLUG A 1 Offset(-48,96)
			SLUG A 1 Offset(-32,86)
			SLUG A 1 Offset(-24,72)
			SLUG A 1 Offset(-16,64)
			SLUG A 1 Offset(-8,48)
			SLUG A 1 Offset(0,32)
		RealReady:
			SLUG A 1 A_WeaponReady
			Loop
			
		Fire:
			TNT1 A 0 A_JumpIf(GetCrouchFactor(AAPTR_DEFAULT) != 1.0, "Fire_Crouch")
		
			TNT1 A 0 A_FireBullets(3.6,3.6,8,5,"SF_BulletPuff")
			TNT1 AAAAAAAA 0 A_FireCustomMissile("SF_BulletTracer",fRandom(-1.8,1.8),FALSE,0,0,0,fRandom(-1.8,1.8))
			
		Fire_Anim:
			TNT1 A 0 A_JumpIfInventory("Power_SF_QuadDamage",0,"QUAD_Sound_Fire")
			Goto QUAD_Nosound_Fire
			
		QUAD_Sound_Fire:
			TNT1 A 0 A_PlaySound("powerups/quad/attack",CHAN_5)
		QUAD_Nosound_Fire:
			TNT1 A 0 A_SetPitch(pitch-4.0)
			TNT1 A 0 A_ZoomFactor(0.98)
			TNT1 A 0 A_Quake(1.25,5,0,1)
			TNT1 A 0 Offset(-1,32) A_PlaySound("weapons/slugger/fire",CHAN_WEAPON)
			TNT1 A 0 Offset(0,32) A_GunFlash
			SLUG A 1 A_Recoil(0.25)
			TNT1 A 0 A_SetPitch(pitch+0.5)
			SLUG A 1 Offset(0,42) A_ZoomFactor(1.0)
			TNT1 A 0 A_SetPitch(pitch+0.5)
			SLUG A 1 Offset(0,48) A_SetPitch(pitch+0.5)
			SLUG A 1 Offset(0,52) A_SetPitch(pitch+0.5)
			SLUG A 1 Offset(0,54) A_SetPitch(pitch+0.5)
			SLUG A 1 Offset(0,56) A_SetPitch(pitch+0.5)
			SLUG A 1 Offset(0,54) A_SetPitch(pitch+0.5)
			SLUG A 1 Offset(0,52) A_SetPitch(pitch+0.5)
			SLUG A 1 Offset(0,48)
			SLUG A 1 Offset(0,42)
			SLUG A 1 Offset(0,40)
			SLUG A 1 Offset(0,36)
			SLUG B 1 Offset(0,32)
			SLUG B 2 Offset(0,42)
			SLUG C 2 Offset(0,46) A_PlaySound("weapons/slugger/pump",CHAN_7)
			SLUG C 1 Offset(0,52)
			SLUG D 1 Offset(0,54)
			SLUG D 1 Offset(0,56)
			SLUG E 1 Offset(0,57)
			SLUG E 1 Offset(0,58)
			SLUG D 1 Offset(0,54)
			SLUG D 1 Offset(0,52)
			SLUG C 1 Offset(0,46)
			SLUG C 1 Offset(0,42)
			SLUG B 1 Offset(0,40)
			SLUG B 2 Offset(0,38)
			SLUG A 2 Offset(0,36)
			SLUG A 2 Offset(0,34)
			SLUG A 2 Offset(0,32)
			SLUG A 1 Offset(0,30) A_Refire
			SLUG A 1 Offset(0,29) A_Refire
			SLUG A 1 Offset(0,28) A_Refire
			SLUG A 1 Offset(0,30) A_Refire
			SLUG A 2 Offset(0,33) A_Refire
			SLUG A 2 Offset(0,32) A_Refire
			Goto RealReady
			
		Fire_Crouch:
			TNT1 A 0 A_FireBullets(1.8,1.8,8,5,"SF_BulletPuff")
			TNT1 AAAAAAAA 0 A_FireCustomMissile("SF_BulletTracer",fRandom(-0.9,0.9),FALSE,0,0,0,fRandom(-0.9,0.9))
			Goto Fire_Anim
			
		Flash:
			SLUG F 2 Bright A_Light1
			SLUG F 3 Bright A_Light2
			Goto LightDone
		Spawn:
			SHOT A -1
			Stop
	}
}