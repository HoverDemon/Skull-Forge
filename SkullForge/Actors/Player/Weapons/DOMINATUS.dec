ACTOR SF_Dominatus : WF_WeaponBase 82
{
	//$Title Dominatus DBR-6
	//$Sprite SGN2A0
	//$Category Weapons
	Weapon.SelectionOrder 400
	Weapon.AmmoUse 2
	Weapon.AmmoGive 16
	Weapon.AmmoType "Shell"
	Obituary "\cb%o \umhas vaporized by \cr%k's \cmDBR-6."
	Inventory.Pickupmessage "\cqWEAPON AQUIRED: \cbDominatus DBR-6 \c*(SLOT 3)"
	Tag "Dominatus DBR-6"
	Inventory.PickupSound "weapons/dominatus/up"
	Weapon.KickBack 200
	States
	{
		Deselect:
			TNT1 A 0 A_PlaySound("weapons/dominatus/down",CHAN_5)
			SHT2 A 1 Offset(0,32)
			SHT2 A 1 Offset(-8,48)
			SHT2 A 1 Offset(-16,64)
			SHT2 A 1 Offset(-24,72)
			SHT2 B 1 Offset(-32,86)
			SHT2 B 1 Offset(-48,96)
			SHT2 B 1 Offset(-52,112)
			SHT2 B 1 Offset(-64,128)
		ReadlDeselect:
			TNT1 A 0 A_Lower
			Loop
		Select:
			TNT1 A 0 A_Raise
			Loop
			
		Ready:
			TNT1 A 0 A_PlaySound("weapons/dominatus/up",CHAN_5)
			SHT2 B 1 Offset(-64,128)
			SHT2 B 1 Offset(-52,112)
			SHT2 B 1 Offset(-48,96)
			SHT2 B 1 Offset(-32,86)
			SHT2 A 1 Offset(-24,72)
			SHT2 A 1 Offset(-16,64)
			SHT2 A 1 Offset(-8,48)
			SHT2 A 1 Offset(0,32)
		RealReady:
			SHT2 A 1 A_WeaponReady
			Loop
			
		Fire:
			TNT1 A 0 A_FireBullets(7.8,6.3,18,6,"SF_DominatusPuff")
			TNT1 AAAAAAAAAAAAAAAA 0 A_FireCustomMissile("SF_DominatusTracer",fRandom(-3.9,3.9),FALSE,0,0,0,fRandom(-3.15,3.15))
			TNT1 A 0 A_SetPitch(pitch-8.0)
			TNT1 A 0 A_ZoomFactor(0.97)
			TNT1 A 0 A_Quake(2.5,6,0,1)
			TNT1 A 0 Offset(-1,32) A_PlaySound("weapons/dominatus/fire",CHAN_WEAPON)
			TNT1 A 0 Offset(0,32) A_GunFlash
			SHT2 A 1 Bright A_Recoil(0.4)
			TNT1 A 0 A_SetPitch(pitch+0.5)
			SHT2 A 1 Bright Offset(0,40) A_ZoomFactor(1.0)
			TNT1 A 0 A_SetPitch(pitch+0.5)
			
			TNT1 A 0 A_JumpIf(pitch > 64, "CheckForJump1")
		
		Fire_Continue:
			TNT1 A 0 A_JumpIfInventory("Power_SF_QuadDamage",0,"QUAD_Sound_Fire")
			Goto QUAD_Nosound_Fire
			
		QUAD_Sound_Fire:
			TNT1 A 0 A_PlaySound("powerups/quad/attack",CHAN_5)
		QUAD_Nosound_Fire:
			SHT2 A 1 Bright Offset(0,48) A_SetPitch(pitch+0.5)
			SHT2 A 1 Bright Offset(0,54) A_SetPitch(pitch+0.5)
			SHT2 A 1 Bright Offset(0,60) A_SetPitch(pitch+0.5)
			SHT2 A 1 Bright Offset(0,64) A_SetPitch(pitch+0.5)
			SHT2 A 1 Bright Offset(0,68) A_SetPitch(pitch+0.5)
			SHT2 A 1 Offset(0,70) A_SetPitch(pitch+0.5)
			SHT2 A 1 Offset(0,72) A_SetPitch(pitch+0.5)
			SHT2 A 2 Offset(0,73) A_SetPitch(pitch+0.5)
			SHT2 A 1 Offset(0,72) A_SetPitch(pitch+0.5)
			SHT2 A 1 Offset(0,70) A_SetPitch(pitch+0.5)
			SHT2 A 1 Offset(0,66) A_SetPitch(pitch+0.5)
			SHT2 A 1 Offset(0,62) A_SetPitch(pitch+0.5)
			SHT2 A 1 Offset(0,54) A_SetPitch(pitch+0.5)
			SHT2 A 2 Offset(0,46) A_SetPitch(pitch+0.5)
			SHT2 AA 1 Offset(0,42) A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
			SHT2 AA 1 Offset(0,34) A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
			SHT2 AAA 1 Offset(0,32) A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
			SHT2 AA 1 Offset(4,32) A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
			SHT2 AA 1 Offset(8,33) A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
			SHT2 A 1 Offset(16,34)
			SHT2 A 1 Offset(24,35)
			SHT2 B 1 Offset(16,36) A_PlaySound("weapons/dominatus/unload",CHAN_7)
			SHT2 B 1 Offset(24,35) 
			SHT2 B 1 Offset(32,34)
			SHT2 C 1 Offset(24,33)
			SHT2 C 1 Offset(32,32) 
			SHT2 C 1 Offset(40,32)
			SHT2 D 1 Offset(38,32)
			SHT2 D 1 Offset(40,32)
			SHT2 D 1 Offset(40,32) 
			SHT2 E 1 Offset(40,32)
			SHT2 E 1 Offset(40,32)
			SHT2 E 1 Offset(40,32) 
			SHT2 E 1 Offset(40,32) A_PlaySound("weapons/dominatus/load",CHAN_7)
			SHT2 F 2 Offset(44,32)
			SHT2 F 2 Offset(45,32)
			SHT2 F 3 Offset(46,32)
			SHT2 F 2 Offset(44,32)
			SHT2 G 2 Offset(32,32) 
			SHT2 G 2 Offset(24,32) 
			SHT2 G 1 Offset(16,32) 
			SHT2 G 1 Offset(8,32) 
			SHT2 A 1 Offset(0,32)
			SHT2 A 1 Offset(-4,33)
			SHT2 A 1 Offset(-8,34)
			SHT2 A 2 Offset(-10,35)
			SHT2 A 3 Offset(-11,36)
			SHT2 A 2 Offset(-10,35)
			SHT2 A 1 Offset(-8,34)
			SHT2 A 1 Offset(-4,33) A_Refire
			SHT2 A 1 Offset(-2,32) A_Refire
			SHT2 A 1 Offset(0,32) A_Refire
			Goto RealReady
		Flash:
			SH2F A 3 Bright A_Light1
			SH2F B 4 Bright A_Light2
			Goto LightDone
			
		CheckForJump1:
			TNT1 A 0 A_JumpIf(pitch < 270, "CheckForJump2")
			Goto Fire_Continue
		CheckForJump2:
			TNT1 A 0 A_CheckFloor("Fire_Continue")
			TNT1 A 0 A_Recoil(10)
			TNT1 A 0 ThrustThingZ(0,75 + pitch / 6,0,0)
			Goto Fire_Continue
		
		Spawn:
			SGN2 A -1
			Stop
	}
}

Actor SF_DominatusTracer : FastProjectile
{
	Speed 115
	Radius 1
	Height 1
	Damage (0)
	+PAINLESS
	+NOBLOOD
	-BLOODSPLATTER
	States
	{
		Spawn:
			TNT1 A 1
			TNT1 A 0 A_SpawnItem("SF_DominatusTracerEffect",0)
			TNT1 A 0 A_SpawnItem("SF_DominatusTracerEffect",-8)
			TNT1 A 0 A_SpawnItem("SF_DominatusTracerEffect",-16)
			Loop
		Death:
			TNT1 A 0
			Stop
	}
}

Actor SF_DominatusTracerEffect
{
	+NOGRAVITY
	RenderStyle Add
	Alpha 0.8
	+NOINTERACTION
	+BRIGHT
	States
	{
		Spawn:
			HORB B 1 A_SetScale(1.0,1.0)
			HORB B 1 A_SetScale(0.6,0.6)
			HORB B 1 A_SetScale(0.2,0.2)
			Stop
	}
}

Actor SF_DominatusPuff
{	
	+NOGRAVITY
	States
	{
		Spawn:
			TNT1 A 0
			
			TNT1 A 0 A_PlaySound("effect/richoshete",CHAN_BODY)
			PULF AAABBBCCCDDD 1 A_SpawnItemEx("SF_DominatusPuffDeathEffect",fRandom(-0.8,0.8),fRandom(-0.8,0.8),fRandom(-2.8,2.8),fRandom(-2.8,2.8),fRandom(0,1.9))
			Stop
		XDeath:
			TNT1 A 0
			Stop
	}
}

Actor SF_DominatusPuffDeathEffect
{
	+BRIGHT
	RenderStyle Add
	Alpha 0.2
	Scale 0.25
	Gravity 0.1
	States
	{
		Spawn:
			HORB BB 1 A_SetScale(1.0,1.0)
			HORB BB 1 A_SetScale(0.9,0.9)
			HORB BB 1 A_SetScale(1.0,1.0)
			HORB BB 1 A_SetScale(0.9,0.9)
			HORB B 1 A_SetScale(1.0,1.0)
			HORB B 1 A_SetScale(0.7,0.7)
			HORB B 1 A_SetScale(0.4,0.4)
			HORB B 1 A_SetScale(0.1,0.1)
			Stop
	}
}