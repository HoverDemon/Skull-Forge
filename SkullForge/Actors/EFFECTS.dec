Actor SF_Blood replaces Blood
{
	Mass 5
	+NOBLOCKMAP
	+NOTELEPORT
	-ALLOWPARTICLES
	RenderStyle Normal
	Alpha 0.5
	Gravity 0.0001
	States
	{
		Spawn:
			TNT1 A 0 
			TNT1 A 0 A_PlaySound("effect/splatter",CHAN_BODY)
			BLUD CCCBBBAAA 1 A_SpawnItemEx("SF_SmallBlood", frandom(-3.0,3.0),frandom(-3.0,3.0),frandom(-3.0,3.0) ,frandom(-6.0,6.0),frandom(-6.0,6.0),frandom(-2.0,5.0), 0, SXF_NOCHECKPOSITION | SXF_TRANSFERTRANSLATION)
			Stop
	}
}

ACTOR SF_SmallBlood
{
	+THRUACTORS
	+NOTELEPORT
	+FORCEXYBILLBOARD
	+PAINLESS
	+DONTSPLASH
	-ACTIVATEIMPACT
	-ACTIVATEPCROSS
	Radius 4
	Height 4
	RenderStyle Normal
	Gravity 0.8
	Scale 0.75
	States
	{
	Spawn:
		BLUD CB 6 A_CheckFloor("Crash")
		loop
	Crash:
		BLUD A 35
		BLUD AAAAAAAAAAAAAA 1 A_FadeTo(0.0,0.1)
		Stop
	}
}