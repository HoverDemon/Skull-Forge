Actor ENV_MapSoundPlayer 32005
{
	//$Title Local Sound Player
	//$Category Maps/Effects
	//$Arg0 UNUSED Tooltip
	//$Arg0ToolTip "This is used to play sounds around the maps using scripts"
	//$Color 11
	//$NotAngled
	+NOTARGET
	+INVISIBLE
	+NOINTERACTION
	+NOBLOCKMAP
	+CLIENTSIDEONLY
	States
	{
		Spawn:
			ENVS A -1
			Stop
	}
}

Actor ENV_SteamReleaser : SwitchableDecoration 32006
{
	//$Title Steam Producer
	//$Category Maps/Effects
	//$Arg0 UNUSED Tooltip
	//$Arg0ToolTip "This is will spew steam out"
	//$Color 11
  	Height 2
  	Radius 1
 	Mass 0
  	+NOBLOCKMAP
  	+NOGRAVITY
  	+NOINTERACTION
	+INVISIBLE
  	+CLIENTSIDEONLY
  	States
  	{
 		Spawn:
   		ENVS B 0 A_PlaySoundEx("effect/steam", CHAN_7, TRUE)
    	ENVS B 1 A_SpawnItemEx("SteamParticle", 0, 0, 0, (0.1)*Random(35, 40), 0, (0.1)*Random(-5, 5), Random(-8, 8), 128)
    	Loop
  }
}

Actor SteamParticle
{
	Height 1
	Radius 1
	+MISSILE
	+NOGRAVITY
	+NOBLOCKMAP
	RenderStyle Add
	Scale 0.4
	Alpha 0.65
	States
	{
		Spawn:
			STEM A 2 A_SetTranslucent(0.6, 1)
			STEM B 2 A_SetTranslucent(0.55, 1)
    		STEM C 2 A_SetTranslucent(0.5, 1)
    		STEM D 2 A_SetTranslucent(0.45, 1)
    		STEM E 2 A_SetTranslucent(0.4, 1)
    		STEM F 2 A_SetTranslucent(0.35, 1)
    		STEM G 2 A_SetTranslucent(0.3, 1)
    		STEM H 2 A_SetTranslucent(0.25, 1)
    		STEM I 2 A_SetTranslucent(0.2, 1)
   		 	STEM J 2 A_SetTranslucent(0.15, 1)
    		STEM K 2 A_SetTranslucent(0.1, 1)
    		STEM L 2 A_SetTranslucent(0.05, 1)
    		Stop
  	}
}

Actor ENV_WindTunnelEffect 32008
{
	//$Title Wind Tunnel Effect
	//$Category Maps/Effects
	//$Arg0 UNUSED Tooltip
	//$Arg0ToolTip "This will generate wind upwards, it doesn't actually push anything, it's just a visual effect"
	//$Color 11
  	Height 2
  	Radius 1
 	Mass 0
  	+NOBLOCKMAP
  	+NOGRAVITY
  	+NOINTERACTION
	+INVISIBLE
  	+CLIENTSIDEONLY
  	States
  	{
 		Spawn:
            ENVS C 0 A_PlaySoundEx("effect/windtunnel", CHAN_7, TRUE)
            ENVS C 1 A_SpawnItemEx("WindParticle", Random(-64,64), Random(-64,64), Random(0,5), fRandom(-0.1,0.1), fRandom(-0.1,0.1), fRandom(12.3,24.6))
            Loop
  }
}

Actor WindParticle
{
	Height 1
	Radius 1
	+MISSILE
	+NOGRAVITY
	+NOBLOCKMAP
    +RANDOMIZE
	RenderStyle Add
	Scale 0.2
	Alpha 0.35
	States
	{
		Spawn:
			STEM A 1 {
                A_SetTranslucent(0.35, 1);
                A_SetSize(0.2, 0.2);
            }
            STEM B 1 {
                A_SetTranslucent(0.4, 1);
                A_SetSize(0.4, 0.4);
            }
            STEM C 1 {
                A_SetTranslucent(0.55, 1);
                A_SetSize(0.6, 0.6);
            }
            STEM D 1 {
                A_SetTranslucent(0.7, 1);
                A_SetSize(0.8, 0.8);
            }
            STEM E 1 {
                A_SetTranslucent(0.75, 1);
                A_SetSize(1.0, 1.0);
            }
            STEM F 1 {
                A_SetTranslucent(0.77, 1);
                A_SetSize(1.2, 1.2);
            }
            STEM G 1 {
                A_SetTranslucent(0.76, 1);
                A_SetSize(1.4, 1.4);
            }
            STEM H 1 {
                A_SetTranslucent(0.7, 1);
                A_SetSize(1.6, 1.6);
            }
            STEM I 1 {
                A_SetTranslucent(0.6, 1);
                A_SetSize(1.8, 1.8);
            }
            STEM J 1 {
                A_SetTranslucent(0.5, 1);
                A_SetSize(2.0, 2.0);
            }
            STEM K 1 {
                A_SetTranslucent(0.4, 1);
                A_SetSize(2.2, 2.2);
            }
            STEM L 1 {
                A_SetTranslucent(0.2, 1);
                A_SetSize(2.4, 2.4);
            }
    		Stop
  	}
}

Actor ENV_WindTunnelExit 32009
{
	//$Title Wind Tunnel Noise Player
	//$Category Maps/Effects
	//$Arg0 UNUSED Tooltip
	//$Arg0ToolTip "This is used to play the wind howling at the other end of a wind tunnel"
	//$Color 11
	//$NotAngled
	+NOTARGET
	+INVISIBLE
	+NOINTERACTION
	+NOBLOCKMAP
	+CLIENTSIDEONLY
	States
	{
		Spawn:
            ENVS A 0
            ENVS A 0 A_PlaySoundEx("effect/windtunnel/end", CHAN_VOICE)
			ENVS AAAA 35
			Loop
	}
}

Actor ENV_ReverseWindTunnelEffect 32010
{
	//$Title Reverse Wind Tunnel Effect
	//$Category Maps/Effects
	//$Arg0 UNUSED Tooltip
	//$Arg0ToolTip "This will generate wind downwards, it doesn't actually push anything, it's just a visual effect"
	//$Color 11
  	Height 2
  	Radius 1
 	Mass 0
  	+NOBLOCKMAP
  	+NOGRAVITY
  	+NOINTERACTION
	+INVISIBLE
  	+CLIENTSIDEONLY
  	States
  	{
 		Spawn:
			TNT1 A 0
		MakeArg0:
			ENVS C 0 A_SetArg(0, Random(-164,164))
			ENVS C 0 A_JumpIf(Args[0] == 0, "MakeArg0")
		MakeArg1:
			ENVS C 0 A_SetArg(1, Random(-164,164))
			ENVS C 0 A_JumpIf(Args[1] == 0, "MakeArg1")
		MainState:
			ENVS C 0 A_PlaySoundEx("effect/windtunnel", CHAN_7, TRUE)
            ENVS C 1 A_SpawnItemEx("WindParticle", Args[0], Args[1], Random(32,64), fRandom(5.0,11.9) * ((Args[0] / abs(Args[0])) * -1), fRandom(5.0,11.9) * ((Args[1] / abs(Args[1])) * -1), fRandom(-32.6,-12.3))
            Goto MakeArg0
  }
}

Actor ENV_RandomWaterSplash 32011
{
	+NOGRAVITY
	-SOLID
	+NOCLIP
	RenderStyle Translucent
	Alpha 0.5
	States
	{
		Spawn:
			TNT1 A 1
			Loop
		Splash:
			TNT1 A 0 A_SetScale(fRandom(1.5,2.5), fRandom(1.5,2.5))
			TNT1 A 1 A_SetTics(Random(0,7))
			SPSH EF 7 A_SetTics(Random(5,7))
			SPSH GHIJK 6 A_SetTics(Random(4,6))
			Goto Spawn
	}
}