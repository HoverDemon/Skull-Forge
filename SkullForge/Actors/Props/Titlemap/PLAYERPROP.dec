Actor TITLEMAPRPOP_PlayeProp 32001
{
	//$Title Carl Titlemap
	//$Category Props/Titlemap
	Scale 1.5
	States
	{
		Spawn:
			PPRP AHAHAHAHA 70
			PPRP H 30
			PPRP IJK 4
			PPRP LMOPQRSTU 2
			PPRP H 18
			Loop
	}
}

Actor TITLEMAPRPOP_Lamp 32002
{
	//$Title Titlemap Blinker
	//$Category Props/Titlemap
	//Arg 0 is weather it
	Scale 1.5
	States
	{
		Spawn:
			PPRP B 70
			TNT1 A 0 A_JumpIf(Args[1] == 1,2)
			TNT1 A 0 A_Jump(64,8)
			TNT1 A 0 A_JumpIf(Args[0] == 0,2)
			TNT1 A 0 A_PlaySound("effect/ping",CHAN_BODY,0.05)
			PPRP CDEFG 3
			TNT1 A 0
			Loop
	}
}

Actor TITLEMAPPROP_WindPlayer 32003
{
	//$Title Wind Player (Global)
	//$Category Props/Titlemap
	Mass 0
	States
	{
		Spawn:
			TNT1 AAA 35
		Spawn_025:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.025,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
		Spawn_05:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.05,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
		Spawn_075:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.075,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
		Spawn_1:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.1,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
		Spawn_125:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.125,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
			TNT1 A 0 A_JumpIf(Mass == 1,"Spawn_15")
			loop
		Spawn_15:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.15,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
		Spawn_175:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.175,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
		Spawn_2:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.2,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
		Spawn_225:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.225,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
		Spawn_25:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.25,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
		Spawn_275:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.275,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
		Spawn_3:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.3,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
		Spawn_325:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.325,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
		Spawn_35:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.35,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
		Spawn_375:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.375,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
		Spawn_4:
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY,0.4,0.0,ATTN_NONE)
			TNT1 AAAAAA 35
			loop
	}
}

Actor TITLEMAPPROP_WindPlayerLocal 32004
{
	//$Title Wind Player (Local)
	//$Category Props/Titlemap
	States
	{
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_PlaySound("effect/wind",CHAN_BODY)
			TNT1 AAAAAA 35
			Loop
	}
}

Actor ENV_MapSoundPlayer 32005
{
	//$Title Local Sound Player
	//$Category Maps/Effects
	//$Arg0 UNUSED Tooltip
	//$Arg0ToolTip "This is used to play sounds around the maps using scripts"
	//$Color 11
	//$NotAngled
	+NOTARGET
	+INVISIBLE
	+NOINTERACTION
	+NOBLOCKMAP
	+CLIENTSIDEONLY
	States
	{
		Spawn:
			ENVS A -1
			Stop
	}
}

Actor ENV_SteamReleaser : SwitchableDecoration 32006
{
	//$Title Steam Producer
	//$Category Maps/Effects
	//$Arg0 UNUSED Tooltip
	//$Arg0ToolTip "This is will spew steam out"
	//$Color 11
  	Height 2
  	Radius 1
 	Mass 0
  	+NOBLOCKMAP
  	+NOGRAVITY
  	+NOINTERACTION
	+INVISIBLE
  	+CLIENTSIDEONLY
  	States
  	{
 		Spawn:
   		ENVS B 0 A_PlaySoundEx("effect/steam", CHAN_7, TRUE)
    	ENVS B 1 A_SpawnItemEx("SteamParticle", 0, 0, 0, (0.1)*Random(35, 40), 0, (0.1)*Random(-5, 5), Random(-8, 8), 128)
    	Loop
  }
}

Actor SteamParticle
{
	Height 1
	Radius 1
	+MISSILE
	+NOGRAVITY
	+NOBLOCKMAP
	RenderStyle Add
	Scale 0.4
	Alpha 0.65
	States
	{
		Spawn:
			STEM A 2 A_SetTranslucent(0.6, 1)
			STEM B 2 A_SetTranslucent(0.55, 1)
    		STEM C 2 A_SetTranslucent(0.5, 1)
    		STEM D 2 A_SetTranslucent(0.45, 1)
    		STEM E 2 A_SetTranslucent(0.4, 1)
    		STEM F 2 A_SetTranslucent(0.35, 1)
    		STEM G 2 A_SetTranslucent(0.3, 1)
    		STEM H 2 A_SetTranslucent(0.25, 1)
    		STEM I 2 A_SetTranslucent(0.2, 1)
   		 	STEM J 2 A_SetTranslucent(0.15, 1)
    		STEM K 2 A_SetTranslucent(0.1, 1)
    		STEM L 2 A_SetTranslucent(0.05, 1)
    		Stop
  	}
}

Actor SF_SubjectTurn 32007
{
	//$Title Human Tunrs into Subject
	//$Category Maps/CinematicProps
	//$Color 12
	Monster
	Health 900
	Radius 16
	Height 56
	Speed 0
	SeeSound "monsters/turning/scream"
	DropItem "SF_Subject"
	+LOOKALLAROUND
	States
	{
		Spawn:
			PLAY A 1 A_Look
			loop
		See:
			PLAY G 35
			PLAY H 3 Offset(8,32) A_Scream
			PLAY H 3 Offset(-8,32)
			PLAY H 3 Offset(8,32)
			PLAY H 3 Offset(-8,32)
			PLAY H 3 Offset(8,32)
			PLAY I 3 Offset(-8,32)
			PLAY I 3 Offset(8,32)
			PLAY I 3 Offset(-8,32)
			PLAY I 3 Offset(8,32)
			PLAY I 3 Offset(-8,32)
			TNT1 A 0 A_PlaySound("misc/gibbed",CHAN_BODY,1.0)
			TNT1 AAAAAA 0 A_SpawnItemEx("SF_SmallBlood",Random(-8,8),Random(-8,8),Random(24,56),fRandom(-4,4),fRandom(-4,4),fRandom(4,12))

			TNT1 A 0 A_NoBlocking
			TNT1 A 1
			TNT1 A 1 A_AlertMonsters
			Stop
	}
}