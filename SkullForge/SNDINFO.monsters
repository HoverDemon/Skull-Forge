//### Generic ###

monsters/generic/missile/fire MISLSUMN
monsters/generic/missile/explode MISLEXPL
$limit monsters/generic/missile/explode 8

monsters/turning/scream SCREAM

//### Berserkeer ###

$Random monsters/berserker/see { berserker/see1 berserker/see2 berserker/see3 }

berserker/see1 MBRSSIT1
berserker/see2 MBRSSIT2
berserker/see3 MBRSSIT3

$Random monsters/berserker/active { berserker/active1 berserker/active2 }

berserker/active1 MBRSACT1
berserker/active2 MBRSACT2

$Random monsters/berserker/pain { berserker/pain1 berserker/pain2 }

berserker/pain1 MBRSPIN1
berserker/pain2 MBRSPIN2

$Random monsters/berserker/death { berserker/death1 berserker/death2 berserker/death3 }

berserker/death1 MBRSDTH1
berserker/death2 MBRSDTH2
berserker/death3 MBRSDTH3

$Random monsters/berserker/attack { berserker/attack1 berserker/attack2 berserker/attack3 berserker/attack4 }

berserker/attack1 MBRSATK1
berserker/attack2 MBRSATK2
berserker/attack3 MBRSATK3
berserker/attack4 MBRSATK4

//### Hatchling ###

$Random monsters/hatchling/see { hatchling/see1 hatchling/see2 hatchling/see3 }

hatchling/see1 HTCHSIT1
hatchling/see2 HTCHSIT2
hatchling/see3 HTCHSIT3

monsters/hatchling/active HTCHACT1

$Random monsters/hatchling/attack { hatchling/attack1 hatchling/attack2 hatchling/attack3 }

hatchling/attack1 HTCHATK1
hatchling/attack2 HTCHATK2
hatchling/attack3 HTCHATK3

