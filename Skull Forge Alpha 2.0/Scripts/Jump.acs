#include "zcommon.acs"

Script "SkullForge_CustomJumpingScript" (Void)
{
	if(GetActorZ(0) == GetActorFloorZ(0) || GetActorZ(0) <= GetActorFloorZ(0) + 16)
	{
		ThrustThingZ(0,GetActorProperty(0,APROP_JUMPZ) / 15000,0,0);
		ThrustThing(GetActorAngle(0) >> 8,1,0,0);
		//print(i:GetActorAngle(0) >> 8);
	}
}