ACTOR SF_QuadDamage : PowerupGiver 2024
{
	//$Title Quad Damage
	//$Category PowerUps
	//$Category Pickups/Power ups
	//$Colour 9
	//$NotAngled
	+COUNTITEM
	+NOGRAVITY
	+FLOATBOB
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	Inventory.PickupMessage "Quad Damage!"
	Inventory.PickupSound "powerups/quad/on"
	Powerup.Type "_SF_QuadDamage"
	Powerup.Color 255, 0, 255, 0.25
	Powerup.Duration -30
	RenderStyle Add
	Alpha 0.8
	States
	{
		Spawn:	
			QDMG ABCDCB 5 Bright
			Loop
		Pickup:
			TNT1 A 1050
			TNT1 A 0 A_PlaySound("powerups/quad/off",CHAN_BODY)
			Stop
	}
}

ACTOR Power_SF_QuadDamage : PowerDamage
{
	Damagefactor "normal", 4
}