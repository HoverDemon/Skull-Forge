ACTOR SF_Slugger : WF_WeaponBase replaces Shotgun
{
	//$Title M-19 Slugger
	//$Sprite SHOTA0
	Weapon.SelectionOrder 1300
	Weapon.AmmoUse 1
	Weapon.AmmoGive 8
	Weapon.AmmoType "Shell"
	Obituary "\cb%o \umhas a bowling ball sized hole in his chest by \cr%k's \cmM-19."
	Inventory.Pickupmessage "\cqWEAPON AQUIRED: \cbM-19 Slugger \c*(SLOT 3)"
	Tag "M-19 Slugger"
	Inventory.PickupSound "weapons/slugger/up"
	Weapon.KickBack 100
	States
	{
		Deselect:
			TNT1 A 0 A_PlaySound("weapons/slugger/down",CHAN_6)
			SHTG A 1 Offset(0,32)
			SHTG A 1 Offset(-8,48)
			SHTG A 1 Offset(-16,64)
			SHTG A 1 Offset(-24,72)
			SHTG A 1 Offset(-32,86)
			SHTG A 1 Offset(-48,96)
			SHTG A 1 Offset(-52,112)
			SHTG A 1 Offset(-64,128)
		ReadlDeselect:
			TNT1 A 0 A_Lower
			Loop
		Select:
			TNT1 A 0 A_Raise
			Loop
			
		Ready:
			TNT1 A 0 A_PlaySound("weapons/slugger/up",CHAN_6)
			SHTG A 1 Offset(-64,128)
			SHTG A 1 Offset(-52,112)
			SHTG A 1 Offset(-48,96)
			SHTG A 1 Offset(-32,86)
			SHTG A 1 Offset(-24,72)
			SHTG A 1 Offset(-16,64)
			SHTG A 1 Offset(-8,48)
			SHTG A 1 Offset(0,32)
		RealReady:
			SHTG A 1 A_WeaponReady
			Loop
			
		Fire:
			TNT1 A 0 A_JumpIf(GetCrouchFactor(AAPTR_DEFAULT) != 1.0, "Fire_Crouch")
		
			TNT1 A 0 A_FireBullets(3.6,3.6,8,5,"SF_BulletPuff")
			TNT1 AAAAAAAA 0 A_FireCustomMissile("SF_BulletTracer",fRandom(-1.8,1.8),FALSE,0,0,0,fRandom(-1.8,1.8))
			
		Fire_Anim:
			TNT1 A 0 A_JumpIfInventory("Power_SF_QuadDamage",0,"QUAD_Sound_Fire")
			Goto QUAD_Nosound_Fire
			
		QUAD_Sound_Fire:
			TNT1 A 0 A_PlaySound("powerups/quad/attack",CHAN_5)
		QUAD_Nosound_Fire:
			TNT1 A 0 A_SetPitch(pitch-4.0)
			TNT1 A 0 A_ZoomFactor(0.98)
			TNT1 A 0 A_Quake(1.25,5,0,1)
			TNT1 A 0 Offset(-1,32) A_PlaySound("weapons/slugger/fire",CHAN_WEAPON)
			TNT1 A 0 Offset(0,32) A_GunFlash
			SHTG A 1 Bright A_Recoil(0.25)
			TNT1 A 0 A_SetPitch(pitch+0.5)
			SHTG A 1 Bright Offset(0,38) A_ZoomFactor(1.0)
			TNT1 A 0 A_SetPitch(pitch+0.5)
			SHTG A 1 Bright Offset(0,42) A_SetPitch(pitch+0.5)
			SHTG A 1 Bright Offset(0,48) A_SetPitch(pitch+0.5)
			SHTG A 1 Bright Offset(0,50) A_SetPitch(pitch+0.5)
			SHTG A 1 Offset(-4,52) A_SetPitch(pitch+0.5)
			SHTG A 1 Offset(-8,50) A_SetPitch(pitch+0.5)
			SHTG A 1 Offset(-12,48) A_SetPitch(pitch+0.5)
			SHTG A 1 Offset(-18,42)
			SHTG A 1 Offset(-32,38)
			SHTG B 1 Offset(-16,34)
			SHTG B 1 Offset(-32,32)
			SHTG B 1 Offset(-46,32)
			SHTG C 1 Offset(-32,34)
			SHTG C 2 Offset(-46,34)
			SHTG C 2 Offset(-52,36)
			SHTG C 3 Offset(-54,40) A_PlaySound("weapons/slugger/pump",CHAN_7)
			SHTG D 1 Offset(-56,42) 
			SHTG D 2 Offset(-58,44)
			SHTG D 3 Offset(-60,46)
			SHTG D 2 Offset(-58,44)
			SHTG D 1 Offset(-56,42)
			SHTG C 2 Offset(-54,40)
			SHTG C 2 Offset(-52,36)
			SHTG C 1 Offset(-46,34)
			SHTG B 1 Offset(-46,32)
			SHTG B 1 Offset(-32,32)
			SHTG B 1 Offset(-16,32)
			SHTG A 1 Offset(-32,32)
			SHTG A 1 Offset(-18,32) A_Refire
			SHTG A 2 Offset(-12,32) A_Refire
			SHTG A 2 Offset(-8,32) A_Refire
			SHTG A 2 Offset(0,32) A_Refire
			Goto RealReady
			
		Fire_Crouch:
			TNT1 A 0 A_FireBullets(1.8,1.8,8,5,"SF_BulletPuff")
			TNT1 AAAAAAAA 0 A_FireCustomMissile("SF_BulletTracer",fRandom(-0.9,0.9),FALSE,0,0,0,fRandom(-0.9,0.9))
			Goto Fire_Anim
			
		Flash:
			SHTF A 2 Bright A_Light1
			SHTF B 3 Bright A_Light2
			Goto LightDone
		Spawn:
			SHOT A -1
			Stop
	}
}