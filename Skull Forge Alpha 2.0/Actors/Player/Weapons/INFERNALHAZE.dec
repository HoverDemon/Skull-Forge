ACTOR SF_InfernalHaze : WF_WeaponBase replaces RocketLauncher
{
	//$Title Infernal Haze FC-76
	//$Sprite SGN2A0
	Weapon.SelectionOrder 800
	Weapon.AmmoUse 1
	Weapon.AmmoGive 8
	Weapon.AmmoType "RocketAmmo"
	Obituary "\cb%o \umhas been burned to death by \cr%k's \cmFC-76."
	Inventory.Pickupmessage "\cqWEAPON AQUIRED: \cbInfernal Haze FC-76 \c*(SLOT 5)"
	Tag "Infernal Haze FC-76"
	Inventory.PickupSound "weapons/infernalhaze/down"
	Weapon.KickBack 275
	//+WEAPON.NOAUTOFIRE
	States
	{
		Deselect:
			TNT1 A 0 A_PlaySound("weapons/infernalhaze/down",CHAN_5,0.6)
			INHZ A 1 Offset(0,32)
			INHZ A 1 Offset(-8,48)
			INHZ A 1 Offset(-16,64)
			INHZ A 1 Offset(-24,72)
			INHZ A 1 Offset(-32,86)
			INHZ A 1 Offset(-48,96)
			INHZ A 1 Offset(-52,112)
			INHZ A 1 Offset(-64,128)
		ReadlDeselect:
			TNT1 A 0 A_Lower
			Loop
		Select:
			TNT1 A 0 A_Raise
			Loop
			
		Ready:
			TNT1 A 0 A_PlaySound("weapons/infernalhaze/up",CHAN_5,0.45)
			INHZ A 1 Offset(-128,256)
			INHZ A 1 Offset(-112,232)
			INHZ A 1 Offset(-96,212)
			INHZ A 1 Offset(-84,196)
			INHZ A 1 Offset(-72,184)
			INHZ A 1 Offset(-64,172)
			INHZ A 1 Offset(-52,132)
			INHZ A 1 Offset(-48,112)
			INHZ A 1 Offset(-32,96)
			INHZ A 1 Offset(-16,86)
			INHZ A 1 Offset(-8,64)
			INHZ A 1 Offset(-4,46)
			INHZ A 1 Offset(-2,36)
			INHZ A 1 Offset(-1,33)
			INHZ A 1 Offset(0,32)
			INHZ IHGFFGHIA 2 Offset(-1,32)
		RealReady:
			INHZ A 1 A_WeaponReady
			TNT1 A 0 A_TakeInventory("SF_InfernoHitToken",1)
			Loop
			
		BrunReady:
			TNT1 A 0 A_SetPitch(pitch+1.5)
			goto RealReady
			
		Fire:
			TNT1 A 0 A_FireCustomMissile("SF_InfernalBall",0,TRUE,0,-5)
			TNT1 A 0 A_SetPitch(pitch-9.0)
			TNT1 A 0 A_ZoomFactor(0.96)
			TNT1 A 0 A_Quake(3.25,8,0,1)
			TNT1 A 0 Offset(-1,32) A_PlaySound("weapons/infernalhaze/fire",CHAN_WEAPON)
			TNT1 A 0 Offset(0,32) A_GunFlash
			TNT1 A 0 A_Recoil(1.2)
			TNT1 A 0 A_JumpIfInventory("Power_SF_QuadDamage",0,"QUAD_Sound_Fire")
			Goto QUAD_Nosound_Fire
			
		QUAD_Sound_Fire:
			TNT1 A 0 A_PlaySound("powerups/quad/attack",CHAN_5)
			Goto QUAD_Nosound_Fire
		QUAD_Nosound_Fire:
			TNT1 A 0 A_JumpIfInventory("SF_InfernoHitToken",0,"QUAD_Nosound_Fire_Fast")
			TNT1 A 0 A_PLaySound("weapons/infernalhaze/prefire",CHAN_6,0.6)
			INHZ B 2 Offset(0,48) A_SetPitch(pitch+0.5)
			INHZ B 2 Offset(0,52) A_ZoomFactor(1.0)
			INHZ C 2 Offset(0,64) A_SetPitch(pitch+0.5)
			INHZ C 2 Offset(0,72) A_SetPitch(pitch+0.5)
			INHZ D 2 Offset(0,70) A_SetPitch(pitch+0.5)
			INHZ E 2 Offset(0,68) A_SetPitch(pitch+0.5)
			INHZ F 2 Offset(0,64) A_SetPitch(pitch+0.5)
			INHZ FF 1 Offset(0,60) A_SetPitch(pitch+0.5)
			INHZ GG 1 Offset(0,52) A_SetPitch(pitch+0.5)
			INHZ GG 1 Offset(0,48) A_SetPitch(pitch+0.5)
			TNT1 A 0 A_JumpIfInventory("SF_InfernoHitToken",0,"BrunReady")
			INHZ HH 1 Offset(0,36) A_SetPitch(pitch+0.5)
			INHZ HH 1 Offset(0,32) A_SetPitch(pitch+0.5)
			INHZ II 1 Offset(0,32) A_SetPitch(pitch+0.5)
			INHZ I 2 Offset(0,32)
			INHZ A 1 Offset(0,32) A_Refire
			Goto RealReady
			
		QUAD_Nosound_Fire_Fast:	
			TNT1 A 0 A_TakeInventory("SF_InfernoHitToken",1)
			TNT1 A 0 A_PLaySound("weapons/infernalhaze/fastprefire",CHAN_6,0.6)
			INHZ B 1 Offset(0,48) A_SetPitch(pitch+0.5)
			INHZ B 2 Offset(0,52) A_ZoomFactor(1.0)
			INHZ C 1 Offset(0,64) A_SetPitch(pitch+0.5)
			INHZ C 2 Offset(0,72) A_SetPitch(pitch+0.5)
			INHZ D 1 Offset(0,70) A_SetPitch(pitch+0.5)
			INHZ E 1 Offset(0,68) A_SetPitch(pitch+0.5)
			INHZ F 2 Offset(0,64) A_SetPitch(pitch+0.5)
			INHZ FF 1 Offset(0,60) A_SetPitch(pitch+0.5)
			INHZ GG 1 Offset(0,52) A_SetPitch(pitch+0.5)
			INHZ GG 1 Offset(0,48) A_SetPitch(pitch+0.5)
			INHZ HH 1 Offset(0,36) A_SetPitch(pitch+0.5)
			INHZ HH 1 Offset(0,32) A_SetPitch(pitch+0.5)
			INHZ I 1 Offset(0,32) A_SetPitch(pitch+1.0)
			INHZ A 1 Offset(0,32) A_Refire
			Goto RealReady
		Flash:
			TNT1 A 3 Bright A_Light1
			TNT1 A 4 Bright A_Light2
			Goto LightDone
		
		Spawn:
			INHG A -1
			Stop
	}
}

Actor SF_InfernoHitToken : Inventory { inventory.maxamount 1 }

Actor SF_InfernalBall : FastProjectile
{
	Speed 50
	Radius 8
	Height 16
	Damage 20
	RenderStyle Add
	Alpha 0.6
	+STRIFEDAMAGE
	+BLOODLESSIMPACT
	+NOEXTREMEDEATH
	+HITTRACER
	+NOGRAVITY
	+FORCERADIUSDMG
	ReactionTime 8
	DeathSound "weapons/infernalhaze/explode"
	States
	{
		Spawn:
			INFB AAABBBAAABBB 1 Bright A_SpawnItemEx("SF_InfernalFlame",FRandom(-8,8),FRandom(-8,8),FRandom(-8,8),FRandom(-0.4,0.4),FRandom(-0.4,0.4),FRandom(0.4,0.9))
			INFB A 2 Bright A_SetScale(0.6,0.6)
			INFB AA 1 Bright A_SpawnItemEx("SF_InfernalFlame",FRandom(-8,8),FRandom(-8,8),FRandom(-8,8),FRandom(-0.4,0.4),FRandom(-0.4,0.4),FRandom(0.4,0.9))
			INFB B 2 Bright A_SetScale(0.3,0.3)
			INFB BB 1 Bright A_SpawnItemEx("SF_InfernalFlame",FRandom(-8,8),FRandom(-8,8),FRandom(-8,8),FRandom(-0.4,0.4),FRandom(-0.4,0.4),FRandom(0.4,0.9))
			INFB A 2 Bright A_SetScale(0.2,0.2)
			INFB A 2 Bright A_SpawnItemEx("SF_InfernalFlame",FRandom(-8,8),FRandom(-8,8),FRandom(-8,8),FRandom(-0.4,0.4),FRandom(-0.4,0.4),FRandom(0.4,0.9))
			INFB B 2 Bright A_SetScale(0.1,0.1)
			INFB B 2 Bright A_SpawnItemEx("SF_InfernalFlame",FRandom(-8,8),FRandom(-8,8),FRandom(-8,8),FRandom(-0.4,0.4),FRandom(-0.4,0.4),FRandom(0.4,0.9))
		Death:
			TNT1 A 0 A_Explode(32,64)
			TNT1 A 0 A_RadiusThrust(64,128,RTF_NOIMPACTDAMAGE | RTF_AFFECTSOURCE | RTF_THRUSTZ)
			INFX ABC 4 Bright A_FadeTo(0.0,0.1)
			Stop
		XDeath:
			TNT1 A 0 A_Explode(32,32,!XF_HURTSOURCE)
			TNT1 A 0 A_GiveInventory("SF_InfernoHitToken",1,AAPTR_TARGET)
			TNT1 A 0 A_SpawnItem("SF_InfernalDeathEffect")
		XDeath_Loop:
			TNT1 A 0 A_Explode(4,4,!XF_HURTSOURCE)
			TNT1 A 0 A_PlaySound("weapons/infernalhaze/flame",CHAN_BODY)
			TNT1 A 1 A_Warp(AAPTR_TRACER,0,0,0,0,WARPF_USECALLERANGLE)
			TNT1 AA 0 A_SpawnItemEx("SF_InfernalFlame",Random(-16,16),Random(-16,16),Random(4,48),fRandom(-0.25,0.25),fRandom(-0.25,0.25),fRandom(1.5,2.5))
			
			TNT1 A 1 A_Warp(AAPTR_TRACER,0,0,0,0,WARPF_USECALLERANGLE)
			TNT1 AA 0 A_SpawnItemEx("SF_InfernalFlame",Random(-16,16),Random(-16,16),Random(4,48),fRandom(-0.25,0.25),fRandom(-0.25,0.25),fRandom(1.5,2.5))
			
			TNT1 A 1 A_Warp(AAPTR_TRACER,0,0,0,0,WARPF_USECALLERANGLE)
			TNT1 AA 0 A_SpawnItemEx("SF_InfernalFlame",Random(-16,16),Random(-16,16),Random(4,48),fRandom(-0.25,0.25),fRandom(-0.25,0.25),fRandom(1.5,2.5))
			
			TNT1 A 1 A_Warp(AAPTR_TRACER,0,0,0,0,WARPF_USECALLERANGLE)
			TNT1 AA 0 A_SpawnItemEx("SF_InfernalFlame",Random(-16,16),Random(-16,16),Random(4,48),fRandom(-0.25,0.25),fRandom(-0.25,0.25),fRandom(1.5,2.5))
			
			TNT1 A 1 A_Warp(AAPTR_TRACER,0,0,0,0,WARPF_USECALLERANGLE)
			TNT1 AA 0 A_SpawnItemEx("SF_InfernalFlame",Random(-16,16),Random(-16,16),Random(4,48),fRandom(-0.25,0.25),fRandom(-0.25,0.25),fRandom(1.5,2.5))
			
			TNT1 A 1 A_Warp(AAPTR_TRACER,0,0,0,0,WARPF_USECALLERANGLE)
			TNT1 AA 0 A_SpawnItemEx("SF_InfernalFlame",Random(-16,16),Random(-16,16),Random(4,48),fRandom(-0.25,0.25),fRandom(-0.25,0.25),fRandom(1.5,2.5))
			
			TNT1 A 1 A_Warp(AAPTR_TRACER,0,0,0,0,WARPF_USECALLERANGLE)
			TNT1 AA 0 A_SpawnItemEx("SF_InfernalFlame",Random(-16,16),Random(-16,16),Random(4,48),fRandom(-0.25,0.25),fRandom(-0.25,0.25),fRandom(1.5,2.5))
			
