			Loop
	}
}

Actor SF_InfernalFlame
{
	+NOGRAVITY
	Scale 0.25
	RenderStyle Add
	Alpha 0.5
	States
	{
		Spawn:
			INFF ABAB 4 Bright
			INFF A 2 Bright A_SetScale(0.2,0.2)
			INFF A 2 Bright A_SetScale(0.15,0.15)
			INFF B 2 Bright A_SetScale(0.1,0.1)
			INFF B 2 Bright A_SetScale(0.05,0.05)
			Stop
	}
}

Actor SF_InfernalDeathEffect
{
	RenderStyle Add
	Alpha 0.6
	+NOGRAVITY
	States
	{
		Spawn:
			INFX ABC 5 Bright
			Stop
	}
}