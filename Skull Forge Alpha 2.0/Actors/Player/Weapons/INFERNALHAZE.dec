ACTOR SF_InfernalHaze : WF_WeaponBase replaces PlasmaRifle
{
	//$Title Infernal Haze FC-76
	//$Sprite SGN2A0
	Weapon.SelectionOrder 600
	Weapon.AmmoUse 1
	Weapon.AmmoGive 8
	Weapon.AmmoType "Cell"
	Obituary "\cb%o \umhas been burned to death by \cr%k's \cmFC-76."
	Inventory.Pickupmessage "\cqWEAPON AQUIRED: \cbInfernal Haze FC-76 \c*(SLOT 6)"
	Tag "Infernal Haze FC-76"
	Inventory.PickupSound "weapons/infernalhaze/up"
	Weapon.KickBack 300
	States
	{
		Deselect:
			TNT1 A 0 A_PlaySound("weapons/infernalhaze/down",CHAN_5)
			INHZ A 1 Offset(0,32)
			INHZ A 1 Offset(-8,48)
			INHZ A 1 Offset(-16,64)
			INHZ A 1 Offset(-24,72)
			INHZ A 1 Offset(-32,86)
			INHZ A 1 Offset(-48,96)
			INHZ A 1 Offset(-52,112)
			INHZ A 1 Offset(-64,128)
		ReadlDeselect:
			TNT1 A 0 A_Lower
			Loop
		Select:
			TNT1 A 0 A_Raise
			Loop
			
		Ready:
			TNT1 A 0 A_PlaySound("weapons/infernalhaze/up",CHAN_5)
			INHZ A 1 Offset(-64,128)
			INHZ A 1 Offset(-52,112)
			INHZ A 1 Offset(-48,96)
			INHZ A 1 Offset(-32,86)
			INHZ A 1 Offset(-24,72)
			INHZ A 1 Offset(-16,64)
			INHZ A 1 Offset(-8,48)
			INHZ A 1 Offset(0,32)
		RealReady:
			INHZ A 1 A_WeaponReady
			Loop
			
		Fire:
			TNT1 A 0 A_FireCustomMissile("SF_InfernalBall",0,TRUE,0,-5)
			TNT1 A 0 A_SetPitch(pitch-9.0)
			TNT1 A 0 A_ZoomFactor(0.96)
			TNT1 A 0 A_Quake(3.25,8,0,1)
			TNT1 A 0 Offset(-1,32) A_PlaySound("weapons/infernalhaze/fire",CHAN_WEAPON)
			TNT1 A 0 Offset(0,32) A_GunFlash
			TNT1 A 0 A_Recoil(1.2)
			TNT1 A 0 A_JumpIfInventory("Power_SF_QuadDamage",0,"QUAD_Sound_Fire")
			Goto QUAD_Nosound_Fire_Fast
			
		QUAD_Sound_Fire:
			TNT1 A 0 A_PlaySound("powerups/quad/attack",CHAN_5)
			Goto QUAD_Nosound_Fire_Fast
		QUAD_Nosound_Fire:
			INHZ B 2 Offset(0,48) A_SetPitch(pitch+0.5)
			INHZ B 2 Offset(0,52) A_ZoomFactor(1.0)
			INHZ C 2 Offset(0,64) A_SetPitch(pitch+0.5)
			INHZ C 2 Offset(0,72) A_SetPitch(pitch+0.5)
			INHZ D 2 Offset(0,70) A_SetPitch(pitch+0.5)
			INHZ E 2 Offset(0,68) A_SetPitch(pitch+0.5)
			INHZ F 2 Offset(0,64) A_SetPitch(pitch+0.5)
			INHZ FF 1 Offset(0,60) A_SetPitch(pitch+0.5)
			INHZ GG 1 Offset(0,52) A_SetPitch(pitch+0.5)
			INHZ GG 1 Offset(0,48) A_SetPitch(pitch+0.5)
			INHZ HH 1 Offset(0,36) A_SetPitch(pitch+0.5)
			INHZ HH 1 Offset(0,32) A_SetPitch(pitch+0.5)
			INHZ II 1 Offset(0,32) A_SetPitch(pitch+0.5)
			INHZ I 2 Offset(0,32)
			INHZ A 1 Offset(0,32) A_Refire
			Goto RealReady
			
		QUAD_Nosound_Fire_Fast:	
			INHZ B 1 Offset(0,48) A_SetPitch(pitch+0.5)
			INHZ B 2 Offset(0,52) A_ZoomFactor(1.0)
			INHZ C 1 Offset(0,64) A_SetPitch(pitch+0.5)
			INHZ C 2 Offset(0,72) A_SetPitch(pitch+0.5)
			INHZ D 1 Offset(0,70) A_SetPitch(pitch+0.5)
			INHZ E 1 Offset(0,68) A_SetPitch(pitch+0.5)
			INHZ F 2 Offset(0,64) A_SetPitch(pitch+0.5)
			INHZ FF 1 Offset(0,60) A_SetPitch(pitch+0.5)
			INHZ GG 1 Offset(0,52) A_SetPitch(pitch+0.5)
			INHZ GG 1 Offset(0,48) A_SetPitch(pitch+0.5)
			INHZ HH 1 Offset(0,36) A_SetPitch(pitch+0.5)
			INHZ HH 1 Offset(0,32) A_SetPitch(pitch+0.5)
			INHZ I 1 Offset(0,32) A_SetPitch(pitch+1.0)
			INHZ A 1 Offset(0,32) A_Refire
			Goto RealReady
		Flash:
			TNT1 A 3 Bright A_Light1
			TNT1 A 4 Bright A_Light2
			Goto LightDone
		
		Spawn:
			INHG A -1
			Stop
	}
}

Actor SF_InfernalBall : FastProjectile
{
	Speed 90
	Radius 8
	Height 16
	Damage (30)
	+PAINLESS
	-BLOODSPLATTER
	States
	{
		Spawn:
			TNT1 A 1
			Loop
		Death:
			TNT1 A 0
			Stop
	}
}