ACTOR SF_NOVA : WF_WeaponBase replaces Pistol 5010
{
	//$Title NOVA-9
	//$Sprite PISTA0
	//$Category Weapons
	Weapon.SelectionOrder 1900
	Weapon.AmmoUse 1
	Weapon.AmmoGive 20
	Weapon.AmmoType "Clip"
	Obituary "\cb%o \umdommed by \cr%k's \cmNOVA-9."
	Inventory.Pickupmessage "\cqWEAPON AQUIRED: \cbNOVA-9 \c*(SLOT 2)"
	Tag "NOVA-9"
	Inventory.PickupSound "weapons/nova/up"
	+WEAPON.NOAUTOFIRE
	Weapon.KickBack 50
	States
	{
		Deselect:
			TNT1 A 0 A_JumpIf(CountInv("SF_ThunderBoltUpgrade") == 1,"ThunderBolt_Deselect")

			TNT1 A 0 A_PlaySound("weapons/nova/down",CHAN_6)
			PISG A 1 Offset(0,32)
			PISG A 1 Offset(-8,48)
			PISG A 1 Offset(-16,64)
			PISG A 1 Offset(-24,72)
			PISG A 1 Offset(-32,86)
			PISG A 1 Offset(-48,96)
			PISG A 1 Offset(-52,112)
			PISG A 1 Offset(-64,128)
		ReadlDeselect:
			TNT1 A 0 A_Lower
			Loop
		Select:
			TNT1 A 0 A_Raise
			Loop
			
		Ready:
			TNT1 A 0 A_JumpIf(CountInv("SF_ThunderBoltUpgrade") == 1,"ThunderBolt_Ready")

			TNT1 A 0 A_PlaySound("weapons/nova/up",CHAN_6)
			PISG A 1 Offset(-64,128)
			PISG A 1 Offset(-52,112)
			PISG A 1 Offset(-48,96)
			PISG A 1 Offset(-32,86)
			PISG A 1 Offset(-24,72)
			PISG A 1 Offset(-16,64)
			PISG A 1 Offset(-8,48)
			PISG A 1 Offset(0,32)
		RealReady:
            TNT1 A 0 A_JumpIf(CountInv("SF_ThunderBoltUpgrade") == 1,"ThunderBolt_RealReady")

			PISG A 1 A_WeaponReady
			Loop
			
		Fire:
			TNT1 A 0 A_JumpIf(CountInv("SF_ThunderBoltUpgrade") == 1,"ThunderBolt_Fire")

			TNT1 A 0 A_JumpIf(GetDistance(True,AAPTR_PLAYER_GETTARGET) >= 500,"Fire_LongRange")
			TNT1 A 0 A_FireBullets(0.8,0.8,1,5,"SF_BulletPuff")
			TNT1 A 0 A_FireCustomMissile("SF_BulletTracer",fRandom(-0.8,0.8),FALSE)
		Fire_Anim:
			TNT1 A 0 A_JumpIfInventory("Power_SF_QuadDamage",0,"QUAD_Sound_Fire")
			Goto QUAD_Nosound_Fire
			
		QUAD_Sound_Fire:
			TNT1 A 0 A_PlaySound("powerups/quad/attack",CHAN_5)
		QUAD_Nosound_Fire:
			TNT1 A 0 A_SetPitch(pitch-2.0)
			TNT1 A 0 A_ZoomFactor(0.99)
			TNT1 A 0 A_Quake(0.75,5,0,1)
			TNT1 A 0 A_PlaySound("weapons/nova/fire",CHAN_WEAPON)
			TNT1 A 0 A_GunFlash
			PISG B 1 Bright A_Recoil(0.1)
			TNT1 A 0 A_SetPitch(pitch+1.0)
			PISG B 1 Bright A_ZoomFactor(1.0)
			TNT1 A 0 A_SetPitch(pitch+1.0)
			PISG C 1
			//TNT1 A 0 A_FireCustomMissile("SF_BulletSpawner", 0,0,frandom(20.5,20.6),1) If we want that
			PISG DDEEEDDCBA 1 A_WeaponReady(WRF_NOSECONDARY | WRF_NOBOB | WRF_NOSWITCH)
			Goto RealReady

		Fire_LongRange:
			TNT1 A 0 A_FireBullets(0.8,0.8,1,10,"SF_BulletPuff")
			TNT1 A 0 A_FireCustomMissile("SF_BulletTracer",fRandom(-0.8,0.8),FALSE)
			Goto Fire_Anim

		Flash:
			PISF A 1 Bright A_Light1
			PISF A 1 Bright A_Light2
			Goto LightDone
		Spawn:
			PIST A -1
			Stop

		//THUNDERBOLT UPGRADE STATES
	
		ThunderBolt_Deselect:
			TNT1 A 0 A_PlaySound("weapons/nova/down",CHAN_6)
			THNB A 1 Offset(0,32)
			THNB A 1 Offset(-8,48)
			THNB A 1 Offset(-16,64)
			THNB A 1 Offset(-24,72)
			THNB A 1 Offset(-32,86)
			THNB A 1 Offset(-48,96)
			THNB A 1 Offset(-52,112)
			THNB A 1 Offset(-64,128)
			Goto ReadlDeselect

		ThunderBolt_Ready:
			TNT1 A 0 A_PlaySound("weapons/nova/up",CHAN_6)
			THNB A 1 Offset(-64,128) A_ChangeFlag("WEAPON.NOAUTOFIRE",False)
			THNB A 1 Offset(-52,112)
			THNB A 1 Offset(-48,96)
			THNB A 1 Offset(-32,86)
			THNB A 1 Offset(-24,72)
			THNB A 1 Offset(-16,64)
			THNB A 1 Offset(-8,48)
			THNB A 1 Offset(0,32)
		ThunderBolt_RealReady:
			THNB A 1 A_WeaponReady
			Loop
			
		ThunderBolt_Fire:
			THNB B 1 Bright Offset(0,46) {
				A_FireBullets(2.2,2.6,2,5,"SF_DominatusPuff");
				A_FireCustomMissile("SF_DominatusTracer",fRandom(-2.2,2.2),FALSE,0,0,0,fRandom(-2.6,2.6));
				A_SetPitch(pitch-1.5);
				A_ZoomFactor(0.99);
				A_Quake(0.7,5,0,1);
				A_PlaySound("weapons/nova/fire",CHAN_WEAPON);
				A_GunFlash("ThunderBoltFlash");
				A_Recoil(0.05);
			}
			THNB C 1 Bright Offset(0,52) {
				A_ZoomFactor(1.0);
				A_SetPitch(pitch+0.5);
			}
			THNB D 1 Offset(0,48) A_SetPitch(pitch+0.5)
			THNB D 1 Offset(0,46) {
				A_SetPitch(pitch+0.5);
				A_Refire;
			}
			THNB A 1 Offset(0,36) A_Refire
			THNB A 1 Offset(0,32) A_Refire
			Goto ThunderBolt_RealReady
	
		ThunderBoltFlash:
			TNT1 A 1 Bright A_Light1
			TNT1 A 1 Bright A_Light2
			Goto LightDone
	}
}

Actor SF_ThunderBoltUpgrade : Inventory 3400
{ 
	//$Title ThunderBolt (NOVA-9 Upgrade)
	//$Category Pickups/Upgrades
	//$NotAngled
	//$Colour 13
	+INVENTORY.UNDROPPABLE 
	Inventory.MaxAmount 1 
	Inventory.PickUpMessage "You got the upgrade to the pistol, Thunderbolt-440!"
	Inventory.PickupSound "weapons/upgradepickup"
	States
	{
		Spawn:
			THNI A -1 Bright
			Stop
	}
}

Actor SF_BulletTracer : FastProjectile
{
	Speed 100
	Radius 1
	Height 1
	Damage (0)
	+PAINLESS
	+NOBLOOD
	-BLOODSPLATTER
	States
	{
		Spawn:
			TNT1 A 1
			TNT1 A 0 A_SpawnItem("SF_BulletTracerEffect",0)
			TNT1 A 0 A_SpawnItem("SF_BulletTracerEffect",-8)
			TNT1 A 0 A_SpawnItem("SF_BulletTracerEffect",-16)
			Loop
		Death:
			TNT1 A 0
			Stop
	}
}

Actor SF_BulletTracerEffect
{
	+NOGRAVITY
	RenderStyle Add
	Alpha 0.8
	+NOINTERACTION
	+BRIGHT
	States
	{
		Spawn:
			BULT A 1 A_SetScale(1.0,1.0)
			BULT A 1 A_SetScale(0.6,0.6)
			BULT A 1 A_SetScale(0.2,0.2)
			Stop
	}
}

Actor SF_BulletPuff
{	
	+NOGRAVITY
	+NOEXTREMEDEATH
	States
	{
		Spawn:
			TNT1 A 0
			
			TNT1 A 0 A_PlaySound("effect/richoshete",CHAN_BODY)
			RPUF AAABBBCCCDDD 1 A_SpawnItemEx("SF_BulletPuffDeathEffect",fRandom(-0.8,0.8),fRandom(-0.8,0.8),fRandom(-2.8,2.8),fRandom(-2.8,2.8),fRandom(0,1.9))
			Stop
		XDeath:
			TNT1 A 0
			Stop
	}
}