ACTOR Breacher replaces ShotgunGuy
{
	//$Title Breacher (Shotgunner)
	//$Sprite SPOSE1
	//$Category Monster/Humanoid
	Health 40
	Radius 20
	Height 56
	Mass 100
	Speed 10
	PainChance 170
	Monster
	+NOINFIGHTING
	+FLOORCLIP
	SeeSound "shotguy/sight"
	AttackSound "shotguy/attack"
	PainSound "shotguy/pain"
	DeathSound "shotguy/death"
	ActiveSound "shotguy/active"
	Obituary "%o was misted by a Breacher's Shotgun blast."
	DropItem "Shotgun"
	States
	{
		Spawn:
			SPOS AB 10 A_Look
			Loop
		See:
			SPOS AABBCCDD 3 A_Chase
			Loop
		Missile:
			TNT1 A 0 A_Jump(64,"BetterAccuracy_Missile")
			TNT1 A 0 A_PlaySound ("weapons/slugger/down",CHAN_BODY)
			SPOS EE 6 A_FaceTarget
			TNT1 A 0 A_CustomMissile("SF_EnemyPellet", 32, 7, frandom(-3, 3),CMF_OFFSETPITCH, frandom(-3, 3))
			TNT1 AAAAA 0 A_CustomMissile("SF_EnemyPellet_Silenced", 32, 7, frandom(-3, 3),CMF_OFFSETPITCH, frandom(-3, 3))
			TNT1 A 0 A_PlaySound ("weapons/slugger/fire",CHAN_BODY)
			SPOS F 4 Bright
			SPOS E 10
			TNT1 A 0 A_PlaySound ("weapons/slugger/pump",CHAN_BODY)
			SPOS ABA 6
			Goto See
			
		BetterAccuracy_Missile:
			TNT1 A 0 A_SetSize(20,32)
			TNT1 A 0 A_PlaySound ("weapons/slugger/up",CHAN_BODY)
			SPOS MM 9 A_FaceTarget
			TNT1 AA 0 A_CustomMissile("SF_EnemyPellet", 22, 7, frandom(-1, 1),CMF_OFFSETPITCH, frandom(-1, 1))
			TNT1 AAAA 0 A_CustomMissile("SF_EnemyPellet_Silenced", 22, 7, frandom(-1, 1),CMF_OFFSETPITCH, frandom(-1, 1))
			TNT1 A 0 A_PlaySound ("weapons/slugger/fire",CHAN_BODY)
			SPOS N 4 Bright
			SPOS M 6
			TNT1 A 0 A_SetSize(20,56)
			TNT1 A 0 A_PlaySound ("weapons/slugger/pump",CHAN_BODY)
			SPOS ABA 7
			Goto See
		Pain:
			SPOS G 3
			SPOS G 3 A_Pain
			Goto See
		Death:
			SPOS H 5
			SPOS I 5 A_Scream
			SPOS J 5 A_NoBlocking
			SPOS K 5
			SPOS L -1
			Stop
		XDeath:
			SPOS M 5
			SPOS N 5 A_XScream
			SPOS O 5 A_NoBlocking
			SPOS PQRST 5
			SPOS U -1
			Stop
		Raise:
			SPOS L 5
			SPOS KJIH 5
			Goto See
	}
}

ACTOR SF_EnemyPellet : FastProjectile
{
	Speed 64
	Radius 1
	Height 2
	Scale 0.5
	Damage (3)
	RenderStyle Normal
	SeeSound "weapons/nova/fire"
	+BLOODSPLATTER
	States
	{
		Spawn:
			PELT A 1 Bright
			TNT1 A 0 A_SpawnItem("SF_EnemyPelletTracer",-8)
			TNT1 A 0 A_SpawnItem("SF_EnemyPelletTracer",-16)
			Loop
		Death:
			TNT1 A 0 A_PlaySound("effect/richoshete",CHAN_BODY)
			TNT1 AAAAAA 0 A_SpawnItemEX("SF_EnemyPelletDeathEffect",fRandom(-0.5,0.5),fRandom(-0.5,0.5),fRandom(-0.5,0.5),fRandom(-1.2,1.2),fRandom(-1.2,1.2),fRandom(1.2,2.4))
			HPUF ABCD 3
			Stop
		XDeath:
			TNT1 A 0
			TNT1 A 0 A_PlaySound("effect/splatter",CHAN_BODY)
			Stop
	}
}

ACTOR SF_EnemyPellet_Silenced : SF_EnemyPellet
{
	SeeSound ""
}

Actor SF_EnemyPelletTracer
{
	+NOGRAVITY
	RenderStyle Add
	Alpha 0.8
	Scale 0.5
	+NOINTERACTION
	+BRIGHT
	States
	{
		Spawn:
			PELT B 1 A_SetScale(0.5,0.5)
			PELT B 1 A_SetScale(0.4,0.4)
			PELT B 1 A_SetScale(0.3,0.3)
			PELT B 1 A_SetScale(0.2,0.2)
			PELT B 1 A_SetScale(0.1,0.1)
			Stop
	}
}

Actor SF_EnemyPelletDeathEffect
{
	+BRIGHT
	RenderStyle Add
	Alpha 0.4
	Gravity 0.25
	Scale 0.5
	States
	{
		Spawn:
			PELT BB 1 A_SetScale(1.0,1.0)
			PELT BB 1 A_SetScale(0.9,0.9)
			PELT B 1 A_SetScale(1.0,1.0)
			PELT B 1 A_SetScale(0.9,0.9)
			PELT B 1 A_SetScale(0.8,0.8)
			PELT B 1 A_SetScale(0.7,0.7)
			PELT B 1 A_SetScale(0.6,0.6)
			PELT B 1 A_SetScale(0.5,0.5)
			PELT B 1 A_SetScale(0.4,0.4)
			PELT B 1 A_SetScale(0.3,0.3)
			PELT B 1 A_SetScale(0.2,0.2)
			PELT B 1 A_SetScale(0.1,0.1)
			Stop
	}
}