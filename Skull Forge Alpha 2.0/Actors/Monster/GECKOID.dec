ACTOR SF_Geckoid replaces DoomImp
{
	//$Title Geckoid
	//$Sprite TROOG3
	//$Category Monster/Geckoidal
	Health 60
	Radius 20
	Height 56
	Mass 100
	Speed 12
	PainChance 200
	Monster
	+FLOORCLIP
	+NOINFIGHTING
	SeeSound "monsters/geckoid/see"
	PainSound "monsters/geckoid/pain"
	DeathSound "monsters/geckoid/death"
	ActiveSound "monsters/geckoid/active"
	HitObituary "%o was Ganked by a Geckoid"
	Obituary "%o was Grilled by a Geckoid"
	States
	{
		Spawn:
			TROO AB 10 A_Look
			Loop
		See:
			TROO AABBCCDD 3 A_Chase
			Loop
		Missile:
			TNT1 A 0 A_Jump(128,8)
			TROO EF 8 A_FaceTarget
			TNT1 A 0 A_CustomMissile("SF_GeckoidBall",48,-24)
			TNT1 A 0 A_CustomMissile("SF_GeckoidBall",24,12)
			TNT1 A 0 A_CustomMissile("SF_GeckoidBall",24,-12)
			TROO G 6 A_CustomMissile("SF_GeckoidBall",48,24)
			TNT1 A 0 A_Jump(256,7)
			TROO EF 6 A_FaceTarget
			TROO G 0 A_CustomMissile("SF_GeckoidBall",48,-24,11)
			TROO G 0 A_CustomMissile("SF_GeckoidBall",24,12,-11)
			TROO G 0 A_CustomMissile("SF_GeckoidBall",24,-12,12.2)
			TROO G 6 A_CustomMissile("SF_GeckoidBall",48,24,-12.2)
			TNT1 A 0
			Goto See
		Pain:
			TROO H 2
			TROO H 2 A_Pain
			Goto See
		Death:
			TROO I 8
			TROO J 8 A_Scream
			TROO K 6
			TROO L 6 A_NoBlocking
			TROO M -1
			Stop
		XDeath:
			TROO N 5
			TROO O 5 A_XScream
			TROO P 5
			TROO Q 5 A_NoBlocking
			TROO RST 5
			TROO U -1
			Stop
		Raise:
			TROO ML 8
			TROO KJI 6
			Goto See
	}
}

Actor SF_GeckoidBall Replaces DoomImpBall
{
	Projectile
	Radius 3
	Height 4
	Scale 0.5
	Damage 2
	Speed 15
	FastSpeed 30
	+RANDOMIZE
	RenderStyle Add
	Alpha 0.75
	States
	{
		Spawn:
			BAL1 AAAABBBB 1 Bright A_SpawnItem("SF_GeckoidTrail")
			Loop
		Death:
			TNT1 AAAA 0 A_SpawnItemEx("SF_GeckoidTrail",Random(-2,2),Random(-2,2),Random(-2,2),fRandom(-2.5,2.5),fRandom(-2.5,2.5),fRandom(-2.5,2.5))
			BAL1 CDE 4 Bright
			Stop
	}
}

Actor SF_GeckoidTrail
{
	+NOBLOCKMAP
	RenderStyle Add
	Alpha 0.25
	Scale 0.4
	+NOGRAVITY
	States
	{
		Spawn:
			BAL1 A 1 A_SetScale(0.4,0.4)
			BAL1 A 1 A_SetScale(0.35,0.35)
			BAL1 B 1 A_SetScale(0.3,0.3)
			BAL1 B 1 A_SetScale(0.25,0.25)
			BAL1 A 1 A_SetScale(0.2,0.2)
			BAL1 A 1 A_SetScale(0.15,0.15)
			BAL1 B 1 A_SetScale(0.1,0.1)
			BAL1 B 1 A_SetScale(0.05,0.05)
			Stop
	}
}