Actor SF_Subject 3300
{
    //$category Monster/Post-Human
    //$title Subject (Guarding)
    Monster
    Health 35
    Radius 16
    Height 54
    Mass 80
    Speed 4
    PainChance 200
    SeeSound "monsters/subject/see"
    ActiveSound "monsters/subject/active"
    PainSound "monsters/subject/pain"
    DeathSound "monsters/subject/death"
    MeleeRange 32
    States
    {
        Spawn:
            SUBJ AABB 8 A_Look
            Loop
        See:
            SUBJ AAAA 4 A_Chase
            SUBJ BBBB 2 A_Chase
            SUBJ CCCC 2 A_Chase
            SUBJ DDDD 2 A_Chase
            TNT1 A 0 A_PlaySound("monsters/subject/step",CHAN_BODY)
            Loop
        Melee:
            TNT1 A 0 A_PlaySound("monsters/subject/attack",CHAN_VOICE)
            SUBJ EEEEEE 3 A_FaceTarget
            SUBJ F 2 A_CustomMeleeAttack((13),"monsters/subject/hit","",0,TRUE)
            SUBJ FFF 2 A_FaceTarget
            SUBJ GGGG 3 A_FaceTarget
            Goto See
        Pain:
            SUBJ H 3
            SUBJ H 3 A_Pain
            Goto See
        Death:
            SUBJ I 4 A_Scream
            SUBJ J 8 A_NoBlocking
            SUBJ KL 4
            SUBJ M -1
            Stop
    }
}

Actor SF_Subject_Wander : SF_Subject 3301
{
    //$category Monster/Post-Human
    //$title Subject (Wandering)
    States
    {
        Spawn:
            TNT1 A 0 A_PlaySound("monsters/subject/step",CHAN_BODY)
            SUBJ AAAA 6 { A_Look; A_Wander; }
            SUBJ BBBB 4 { A_Look; A_Wander; }
            SUBJ CCCC 4 { A_Look; A_Wander; }
            SUBJ DDDD 4 { A_Look; A_Wander; }
            Loop
    }
}