ACTOR Warlord replaces Cyberdemon
{
	Health 4000
	Radius 40
	Height 110
	Mass 1000
	Speed 20
	PainChance 20
	Monster
	MinMissileChance 40
	MeleeThreshold 392
	MeleeRange 80
	+BOSS
	+MISSILEMORE
	+MISSILEEVENMORE
	+FLOORCLIP
	+NORADIUSDMG
	+DONTMORPH
	+BOSSDEATH
	+NOPAIN
	+NOINFIGHTING
	SeeSound "cyber/sight"
	DeathSound "DEMODEAT"
	ActiveSound "DEMOACTI"
	Obituary "%o was completely obliterated by a mighty Warlord."
	States
	{
		Spawn:
			DRWA AB 10 A_Look
			Loop
		See:
			DRWA A 0 A_JumpIfInventory("IGoMelee",1,"See2")

			DRWA J 0 A_JumpIfCloser(384,"SwitchToMelee")
			DRWA A 0 A_PlaySound("cyber/hoof")
			DRWA JJ 3 A_Chase("GunAttack","GunAttack")
			DRWA K 0 A_JumpIfCloser(384,"SwitchToMelee")
			DRWA KK 3 A_Chase("GunAttack","GunAttack")
			DRWA L 0 A_JumpIfCloser(384,"SwitchToMelee")
			DRWA A 0 A_PlaySound("cyber/hoof")
			DRWA LL 3 A_Chase("GunAttack","GunAttack")
			DRWA M 0 A_JumpIfCloser(384,"SwitchToMelee")
			DRWA MM 3 A_Chase("GunAttack","GunAttack")
			DRWA N 0 A_JumpIfCloser(384,"SwitchToMelee")
			DRWA A 0 A_PlaySound("cyber/hoof")
			DRWA NN 3 A_Chase("GunAttack","GunAttack")
			DRWA O 0 A_JumpIfCloser(384,"SwitchToMelee")
			DRWA OO 3 A_Chase("GunAttack","GunAttack")
			Loop
		See2:
			DRWA A 0 A_JumpIfCloser(384,2)
			DRWA A 0 A_Jump(256,"SwitchToRanged")
			DRWA A 0 A_PlaySound("cyber/hoof")
			DRWA A 0 A_Chase("SwordAttack","")
			DRWA AA 2 A_Chase("SwordAttack","")
			DRWA A 0 A_JumpIfCloser(384,2)
			DRWA B 0 A_Jump(256,"SwitchToRanged")
			DRWA B 0 A_Chase("SwordAttack","")
			DRWA BB 2 A_Chase("SwordAttack","")
			DRWA A 0 A_JumpIfCloser(384,2)
			DRWA C 0 A_Jump(256,"SwitchToRanged")
			DRWA A 0 A_PlaySound("cyber/hoof")
			DRWA C 0 A_Chase("SwordAttack","")
			DRWA CC 2 A_Chase("SwordAttack","")
			DRWA A 0 A_JumpIfCloser(384,2)
			DRWA D 0 A_Jump(256,"SwitchToRanged")
			DRWA D 0 A_Chase("SwordAttack","")
			DRWA DD 2 A_Chase("SwordAttack","")
			DRWA A 0 A_JumpIfCloser(384,2)
			DRWA E 0 A_Jump(256,"SwitchToRanged")
			DRWA A 0 A_PlaySound("cyber/hoof")
			DRWA E 0 A_Chase("SwordAttack","")
			DRWA EE 2 A_Chase("SwordAttack","")
			DRWA A 0 A_JumpIfCloser(384,2)
			DRWA F 0 A_Jump(256,"SwitchToRanged")
			DRWA F 0 A_Chase("SwordAttack","")
			DRWA FF 2 A_Chase("SwordAttack","")
			Goto See

		SwitchToMelee:
			DRWA P 0 A_GiveInventory("IGoMelee",1)
			DRWA G 0 A_PlaySound("weapons/sshoto")
			DRWA PG 6 A_FaceTarget
			Goto See

		SwitchToRanged:
			DRWA G 0 A_TakeInventory("IGoMelee",1)
			DRWA G 0 A_PlaySound("weapons/sshotl")
			DRWA GP 6 A_FaceTarget
			Goto See

		GunAttack:
			DRWA P 0 A_Jump(256,"PlasmaAttack","RocketAttack")
			DRWA P 1
			Goto PlasmaAttack

		PlasmaAttack:
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBallNoSeeSound",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBallNoSeeSound",70,21,Random(-10,10))
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBallNoSeeSound",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBallNoSeeSound",70,21,Random(-10,10))
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBallNoSeeSound",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBallNoSeeSound",70,21,Random(-10,10))
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBallNoSeeSound",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBallNoSeeSound",70,21,Random(-10,10))
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBallNoSeeSound",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBallNoSeeSound",70,21,Random(-10,10))
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBallNoSeeSound",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBallNoSeeSound",70,21,Random(-10,10))
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBallNoSeeSound",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBallNoSeeSound",70,21,Random(-10,10))
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA P 2 A_FaceTarget
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 0 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			DRWA R 2 A_CustomMissile("DragonPlasmaBall",70,21,Random(-10,10))
			Goto See

		RocketAttack:
			DRWA P 8 A_FaceTarget
			DRWA Q 4 A_CustomMissile("DragonRocket",70,21,Random(-1,1))
			DRWA P 4 A_FaceTarget
			DRWA Q 4 A_CustomMissile("DragonRocket",70,21,Random(-1,1))
			DRWA P 4 A_FaceTarget
			DRWA Q 4 A_CustomMissile("DragonRocket",70,21,Random(-1,1))
			Goto See

		SwordAttack:
			DRWA GH 6 A_FaceTarget
			DRWA I 0 A_SkelWhoosh
			DRWA I 8 A_CustomMeleeAttack(random(5, 20) * 10, "skeleton/melee")
			Goto See


		Death:
			DRWA S 7
			DRWA T 7 A_Scream
			DRWA U 7 A_NoBlocking
			DRWA V 7
			DRWA W -1 A_BossDeath
			Stop
	}
}

Actor IGoMelee : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
}

ACTOR DragonPlasmaBall
{
	Radius 13
	Height 8
	Speed 35
	Damage 3
	Projectile
	+RANDOMIZE
	RenderStyle Add
	Alpha 0.8
	SeeSound "weapons/plasmaf"
	DeathSound "weapons/plasmax"
	States
	{
		Spawn:
			PLSS A 1 Bright
			PLSS A 1 Bright A_SetTranslucent(0.7)
			PLSS A 1 Bright A_SetTranslucent(0.6)
			PLSS A 1 Bright A_SetTranslucent(0.5)
			PLSS A 1 Bright A_SetTranslucent(0.4)
			PLSS A 1 Bright A_SetTranslucent(0.3)
			PLSS A 1 Bright A_SetTranslucent(0.2)
			PLSS B 1 Bright A_SetTranslucent(0.3)
			PLSS B 1 Bright A_SetTranslucent(0.4)
			PLSS B 1 Bright A_SetTranslucent(0.5)
			PLSS B 1 Bright A_SetTranslucent(0.6)
			PLSS B 1 Bright A_SetTranslucent(0.7)
			PLSS B 1 Bright A_SetTranslucent(0.8)
			Loop
		Death:
			PLSE A 0 A_SetTranslucent(0.9)
			PLSE ABCDE 4 Bright
			Stop
	}
}

