ACTOR DragonRocket
{
	Radius 11
	Height 8
	Speed 35
	Damage 20
	Projectile
	+RANDOMIZE
	+DEHEXPLOSION
	+ROCKETTRAIL
	SeeSound "weapons/rocklf"
	DeathSound "weapons/rocklx"
	States
	{
		Spawn:
			MISL A 1 Bright
			Loop
		Death:
			MISL B 8 Bright A_Explode
			MISL C 6 Bright
			MISL D 4 Bright
			Stop
	}
}

ACTOR Warlord2 : Warlord
{
	Translation "16:47=112:127" , "168:191=112:127"
}