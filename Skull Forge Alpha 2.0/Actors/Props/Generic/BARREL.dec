Actor SF_Barrels : RandomSpawner replaces ExplosiveBarrel
{
    DropItem "SF_Barrel_Variant_A", 256, 128
    DropItem "SF_Barrel_Variant_B", 256, 128
}

Actor SF_Barrel_Variant_A
{
    +SHOOTABLE
    Health 30
    Radius 16
    Height 48
    +NOBLOOD
    Mass 120
    States
    {
        Spawn:
            BARL A -1
            Stop
        Death:
            BARL A 1 A_SetScale(1.2,1)
            BARL A 1 A_SetScale(1.35,1)
            BARL A 1 A_SetScale(1.45,1)
            BARL A 1 A_SetScale(1.5,1)
            BARL A 1 A_SetScale(1.525,1)
            BARL A 1 A_SetScale(1.65,1)
            BARL A 2 A_SetScale(1.7125,1)
            BARL A 3 A_SetScale(1.74375,1)
            BARL A 4 A_SetScale(1.759375,1)
            BARL A 5 A_SetScale(1.7671875,1)

            TNT1 A 0 A_Explode(128,256, XF_HURTSOURCE | XF_THRUSTZ)
			TNT1 A 0 A_PlaySound("generic/explosion",CHAN_BODY,1.0)
			TNT1 A 0 A_SpawnItem("SF_Barrel_ExplosionEffect")
			Stop
	}
}

Actor SF_Barrel_Variant_B
{
    +SHOOTABLE
    Health 30
    Radius 16
    Height 48
    +NOBLOOD
    Mass 120
    States
    {
        Spawn:
            BARL B -1
            Stop
        Death:
            BARL B 1 A_SetScale(1.2,1)
            BARL B 1 A_SetScale(1.35,1)
            BARL B 1 A_SetScale(1.45,1)
            BARL B 1 A_SetScale(1.5,1)
            BARL B 1 A_SetScale(1.525,1)
            BARL B 1 A_SetScale(1.65,1)
            BARL B 2 A_SetScale(1.7125,1)
            BARL B 3 A_SetScale(1.74375,1)
            BARL B 4 A_SetScale(1.759375,1)
            BARL B 5 A_SetScale(1.7671875,1)

            TNT1 A 0 A_Explode(128,256, XF_HURTSOURCE | XF_THRUSTZ)
			TNT1 A 0 A_PlaySound("generic/explosion",CHAN_BODY,1.0)
			TNT1 A 0 A_SpawnItem("SF_Barrel_ExplosionEffect")
			Stop
	}
}

Actor SF_Barrel_ExplosionEffect
{
	RenderStyle Add
	Alpha 0.75
    Scale 1.25
	+NOBLOCKMAP
	+NOGRAVITY
	States
	{
		Spawn:
			TNT1 A 0
			NULL A 0 A_Quake(3.5,5,0,256)
			BOOM AB 2 Bright {
				A_SpawnItemEx("SF_Barrel_ExplosionMark",Random(-32,32),Random(-32,32),Random(8,24));
				A_SpawnItemEx("SF_Barrel_ExplosionMark",Random(-32,32),Random(-32,32),Random(8,24));
				A_SpawnItemEx("SF_Barrel_ExplosionMark_Gravity",Random(-2,2),Random(-2,2),Random(0,8),fRandom(-4,4),fRandom(-4,4),fRandom(6.0,12.0));
				A_SpawnItemEx("SF_Barrel_ExplosionMark_Gravity",Random(-2,2),Random(-2,2),Random(0,8),fRandom(-4,4),fRandom(-4,4),fRandom(6.0,12.0));
				A_SpawnItemEx("SF_Barrel_ExplosionMark_Gravity",Random(-2,2),Random(-2,2),Random(0,8),fRandom(-4,4),fRandom(-4,4),fRandom(6.0,12.0));
			}
			NULL A 0 A_Quake(3.0,4,0,296)
			BOOM CDE 1 Bright A_SpawnItemEx("SF_Barrel_ExplosionMark",Random(-32,32),Random(-32,32),Random(8,24))
			NULL A 0 A_Quake(2.0,10,0,332)
			BOOM FGHIJKLM 1 Bright A_SpawnItemEx("SF_Barrel_ExplosionMark_Small",Random(-32,32),Random(-32,32),Random(8,24))
			NULL A 0 A_Quake(1.0,11,0,364)
			BOOM NOPQRSTUV 1 Bright
			Stop
	}
}

Actor SF_Barrel_ExplosionMark
{
	RenderStyle Add
	Alpha 0.5
	Scale 0.75
	+NOBLOCKMAP
	+NOGRAVITY
	States
	{
		Spawn:
			BOOM ABCDEFG 2 Bright
			BOOM HIJKLMNOPQRSTUV 1 Bright A_FadeOut(0.03)
			Stop
	}	
}

Actor SF_Barrel_ExplosionMark_Gravity
{
	-NOGRAVITY
	+NOCLIP
	Gravity 0.4
	States
	{
		Spawn:
			TNT1 AAAAAAAAAAAAA 1 A_SpawnItem("SF_Barrel_ExplosionMark")
			TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_SpawnItem("SF_Barrel_ExplosionMark_Small")
			Stop
	}	
}

Actor SF_Barrel_ExplosionMark_Small : SF_Barrel_ExplosionMark
{
	Scale 0.6
	States
	{
		Spawn:
			BOOM ACEG 1 Bright
			BOOM IKMOQSU 1 Bright A_FadeOut(0.0714285714285714)
			Stop
	}	
}