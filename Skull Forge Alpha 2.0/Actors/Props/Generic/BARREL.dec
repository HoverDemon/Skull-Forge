Actor SF_Barrels : RandomSpawner 2035
{
    DropItem "SF_Barrel_Variant_A", 256, 128
    DropItem "SF_Barrel_Variant_B", 256, 128
}

Actor SF_Barrel_Variant_A
{
    +SHOOTABLE
	+SOLID
    Health 9000
	PainChance 256
	ReactionTime 4
    Radius 16
    Height 48
    +NOBLOOD
    Mass 120
    States
    {
        Spawn:
            BARL A -1
            Stop
		Pain:
			BARL A 1 A_CountDown
			Goto Spawn
        Death:
            BARL A 1 A_SetScale(1.35,1)
            BARL A 1 A_SetScale(1.5,1)
            BARL A 1 A_SetScale(1.65,1)
            BARL A 2 A_SetScale(1.74375,1)
            BARL A 3 
			{	
				A_SetScale(1.7671875,1);
				A_SetTics(Random(3,7));
			}

            TNT1 A 0 A_Explode(128,128, XF_HURTSOURCE | XF_THRUSTZ)
			TNT1 A 0 A_Explode(128,256, XF_HURTSOURCE | XF_THRUSTZ,false,0,0,10,"BulletPuff","NODAMAGEPLAYER")
			TNT1 A 0 A_PlaySound("generic/explosion",CHAN_BODY,1.0)
			TNT1 A 0 A_SpawnItem("SF_Barrel_ExplosionEffect")
			Stop
	}
}

Actor SF_Barrel_Variant_B
{
    +SHOOTABLE
	+SOLID
    Health 9000
	PainChance 256
	ReactionTime 4
    Radius 16
    Height 48
    +NOBLOOD
    Mass 120
    States
    {
        Spawn:
            BARL B -1
            Stop
		Pain:
			BARL A 1 A_CountDown
			Goto Spawn
        Death:
            BARL B 1 A_SetScale(1.35,1)
            BARL B 1 A_SetScale(1.5,1)
            BARL B 1 A_SetScale(1.65,1)
            BARL B 2 A_SetScale(1.74375,1)
            BARL B 3 
			{	
				A_SetScale(1.7671875,1);
				A_SetTics(Random(3,7));
			}

            TNT1 A 0 A_Explode(128,128, XF_HURTSOURCE | XF_THRUSTZ)
			TNT1 A 0 A_Explode(128,256, XF_HURTSOURCE | XF_THRUSTZ,false,0,0,10,"BulletPuff","NODAMAGEPLAYER")
			TNT1 A 0 A_PlaySound("generic/explosion",CHAN_BODY,1.0)
			TNT1 A 0 A_SpawnItem("SF_Barrel_ExplosionEffect")
			Stop
	}
}

Actor SF_Barrel_ExplosionEffect
{
	RenderStyle Add
	Alpha 0.75
    Scale 1.25
	+NOBLOCKMAP
	+NOGRAVITY
	States
	{
		Spawn:
			TNT1 A 0
			NULL A 0 A_Quake(6.0,22,0,128 * 6)
			BOOM AB 1 BRight A_SpawnItemEx("SF_ExplosionMark_Gravity",Random(-32,32),Random(-32,32),Random(-32,32),fRandom(-6,6),fRandom(-6,6),fRandom(6,12))
			BOOM CDEFGHIJK 1 Bright A_SpawnItemEx("SF_ExplosionMark",Random(-32,32),Random(-32,32),Random(-32,32))
			BOOM LMNOPQRSTUV 1 Bright
			Stop
	}
}

Actor SF_Barrel_ExplosionMark
{
	RenderStyle Add
	Alpha 0.5
	Scale 0.75
	+NOBLOCKMAP
	+NOGRAVITY
	States
	{
		Spawn:
			BOOM ABCDEFG 2 Bright
			BOOM HIJKLMNOPQRSTUV 1 Bright A_FadeOut(0.03)
			Stop
	}	
}

Actor SF_Barrel_ExplosionMark_Gravity
{
	-NOGRAVITY
	+NOCLIP
	Gravity 0.4
	States
	{
		Spawn:
			TNT1 AAAAAAAAAAAAA 1 A_SpawnItem("SF_Barrel_ExplosionMark")
			TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_SpawnItem("SF_Barrel_ExplosionMark_Small")
			Stop
	}	
}

Actor SF_Barrel_ExplosionMark_Small : SF_Barrel_ExplosionMark
{
	Scale 0.6
	States
	{
		Spawn:
			BOOM ACEG 1 Bright
			BOOM IKMOQSU 1 Bright A_FadeOut(0.0714285714285714)
			Stop
	}	
}